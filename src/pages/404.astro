---
import Layout from '../layouts/Layout.astro';
import ArrowLink from '../components/atoms/ArrowLink.astro';
import { getCV, t } from '../i18n';

// The 404 route is built once, statically — Astro.currentLocale can't reflect
// an arbitrary missing path, so it renders the default (en) copy server-side
// and a small inline script swaps to the id copy when the path is under /id/.
const { basics } = getCV('en');
const en = t('en').meta.notFound;
const id = t('id').meta.notFound;
const title = `${en.title} — ${basics.name}`;
---

<Layout title={title} description={en.description}>
  <section class="notfound shell">
    <div class="notfound__digits" aria-hidden="true">
      <span class="notfound__digit" style="--i:0">4</span>
      <span class="notfound__digit notfound__digit--accent" style="--i:1">0</span>
      <span class="notfound__digit" style="--i:2">4</span>
    </div>

    <p class="notfound__spec label" aria-hidden="true">
      <span>Fraunces Variable</span>
      <span class="notfound__spec-sep">/</span>
      <span>WGHT 320 → 880</span>
      <span class="notfound__spec-sep">/</span>
      <span>HTTP 404</span>
    </p>

    <h1 class="notfound__title" data-notfound-heading>{en.heading}</h1>
    <p class="notfound__lede" data-notfound-lede>{en.lede}</p>

    <div class="notfound__actions">
      <ArrowLink href="/">{en.backHome}</ArrowLink>
      <ArrowLink href="/#projects-title">{en.seeWork}</ArrowLink>
    </div>
  </section>
</Layout>

<script define:vars={{ idCopy: id }} is:inline>
  if (location.pathname.startsWith('/id/') || location.pathname === '/id') {
    const heading = document.querySelector('[data-notfound-heading]');
    const lede = document.querySelector('[data-notfound-lede]');
    const home = document.querySelector('.notfound__actions a[href="/"]');
    const work = document.querySelector('.notfound__actions a[href="/#projects-title"]');
    if (heading) heading.textContent = idCopy.heading;
    if (lede) lede.textContent = idCopy.lede;
    if (home) {
      const text = home.querySelector('.arrow-link__text');
      if (text) text.textContent = idCopy.backHome;
      home.setAttribute('href', '/id/');
    }
    if (work) {
      const text = work.querySelector('.arrow-link__text');
      if (text) text.textContent = idCopy.seeWork;
      work.setAttribute('href', '/id/#projects-title');
    }
  }
</script>

<style>
  .notfound {
    min-height: 100dvh;
    padding-top: var(--nav-offset);
    padding-bottom: var(--space-xl);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-s);
  }

  /* Concrete-poetry numeral — same weight-ramp motif as the hero name */
  .notfound__digits {
    display: flex;
    line-height: 0.82;
    letter-spacing: -0.03em;
  }
  .notfound__digit {
    display: inline-block;
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 26vw, 14rem);
    font-variation-settings: 'opsz' 144, 'wght' calc(320 + var(--i) * 140), var(--wonk-off);
    transition: font-variation-settings var(--dur-2) var(--ease);
  }
  .notfound__digit--accent {
    color: var(--accent);
  }
  .notfound__digit:hover {
    font-variation-settings: 'opsz' 144, 'wght' 900, 'SOFT' 100, 'WONK' 1;
  }

  .notfound__spec {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em 0.9em;
    align-items: baseline;
    color: var(--faint);
    padding-top: var(--space-2xs);
    border-top: 1px solid var(--line);
  }
  .notfound__spec-sep {
    color: var(--accent);
  }

  .notfound__title {
    font-size: var(--step-3);
    font-variation-settings: 'opsz' 60, 'wght' 460, var(--wonk-off);
    max-width: 16ch;
    margin-top: var(--space-xs);
  }
  .notfound__lede {
    font-size: var(--step-1);
    color: var(--muted);
    max-width: var(--measure-tight);
    text-wrap: pretty;
  }

  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    margin-top: var(--space-s);
  }

  @keyframes notfound-ring {
    0% { box-shadow: 0 0 0 0 color-mix(in oklab, var(--accent) 55%, transparent); }
    70% { box-shadow: 0 0 0 0.7em transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  @media (max-width: 560px) {
    .notfound__actions {
      flex-direction: column;
      gap: var(--space-s);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .notfound__digit { transition: none; }
  }
</style>
