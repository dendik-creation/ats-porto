---
// /slides — the portfolio as a 16:9 pixel-transition slide deck.
// The deck is a self-contained document generated by src/slides/build.py
// (content, deck.css, deck.js); this page serves it as-is. The generator
// links images relative to the standalone file, so re-root them at /public.
import deck from '../slides/portfolio.html?raw';
const html = deck.replaceAll('../../public/', '/');
---

<Fragment set:html={html} />
