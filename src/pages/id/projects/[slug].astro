---
import Layout from '../../../layouts/Layout.astro';
import ProjectDetail from '../../../components/templates/ProjectDetail.astro';
import { getCV } from '../../../i18n';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (() => {
  const { projects } = getCV('id');
  return projects.map((project, i) => {
    const prev = projects[(i - 1 + projects.length) % projects.length];
    const next = projects[(i + 1) % projects.length];
    return {
      params: { slug: project.slug },
      props: { project, index: i + 1, total: projects.length, prev, next },
    };
  });
}) satisfies GetStaticPaths;

const { project, index, total, prev, next } = Astro.props;
const title = `${project.name} — ${getCV('id').basics.name}`;
const description = project.description;
---

<Layout title={title} description={description}>
  <ProjectDetail project={project} index={index} total={total} prev={prev} next={next} />
</Layout>
