---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/bricolage-grotesque/wght.css';
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/atomic.css';
import '../styles/transition.css';

import { ClientRouter } from 'astro:transitions';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { getCV, t, resolveLocale } from '../i18n';
import Nav from '../components/organisms/Nav.astro';
import PageTransition from '../components/organisms/PageTransition.astro';
import ThemeTransitionOverlay from '../components/molecules/ThemeTransitionOverlay.astro';

interface Props {
  title?: string;
  description?: string;
}

const locale = resolveLocale(Astro.currentLocale);
const cv = getCV(locale);
const ui = t(locale);
const { basics } = cv;
const {
  title = `${basics.name} — ${basics.label}`,
  description = basics.summary,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? basics.url).toString();
const ogImage = new URL('/og.svg', Astro.site ?? basics.url).toString();

// hreflang alternates computed from the locale-stripped bare pathname, so
// search engines pair the en/id versions of the same page.
const barePath = Astro.url.pathname.replace(/^\/id(?=\/|$)/, '') || '/';
const enUrl = getAbsoluteLocaleUrl('en', barePath);
const idUrl = getAbsoluteLocaleUrl('id', barePath);

// JSON-LD: Person nested in a ProfilePage for rich results.
const personLd = {
  '@type': 'Person',
  name: basics.name,
  jobTitle: basics.label,
  email: `mailto:${basics.email}`,
  url: basics.url,
  image: ogImage,
  address: {
    '@type': 'PostalAddress',
    addressLocality: basics.location.city,
    addressRegion: basics.location.region,
    addressCountry: basics.location.countryCode,
  },
  sameAs: basics.profiles.map((p) => p.url),
  knowsAbout: cv.skills.flatMap((g) => g.keywords),
  knowsLanguage: cv.languages.map((l) => l.name),
  hasCredential: cv.certificates.map((c) => ({
    '@type': 'EducationalOccupationalCredential',
    name: c.name,
    credentialCategory: 'certificate',
    recognizedBy: { '@type': 'Organization', name: c.issuer },
  })),
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  dateModified: new Date().toISOString(),
  inLanguage: locale,
  mainEntity: personLd,
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="id" href={idUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={basics.name} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" id="theme-color-meta" content="#f0ece1" />

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale === 'id' ? 'id_ID' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'id' ? 'en_US' : 'id_ID'} />
    <meta property="profile:first_name" content="Dendi" />
    <meta property="profile:last_name" content="Setiawan" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    <script defer src="https://cloud.umami.is/script.js" data-website-id="24e3a2ab-1ee5-42df-9a72-6446df7fd411" is:inline></script>

    <script is:inline>
      // Respect an explicit language choice forever; otherwise guess from the
      // browser's language once per visit (not persisted, so it keeps
      // reflecting the visitor's actual browser setting until they pick one).
      // Runs once per hard load — ClientRouter dedupes this identical inline
      // script across soft navigations, which is what prevents redirect loops
      // on in-site link clicks.
      (function () {
        var path = location.pathname;
        var current = /^\/id(\/|$)/.test(path) ? 'id' : 'en';
        var stored = localStorage.getItem('lang');
        var target = stored;
        if (target !== 'en' && target !== 'id') {
          var nav = (navigator.language || 'en').toLowerCase();
          target = nav.indexOf('id') === 0 ? 'id' : 'en';
        }
        if (target !== current) {
          var bare = path.replace(/^\/id(?=\/|$)/, '') || '/';
          var dest = target === 'id' ? (bare === '/' ? '/id/' : '/id' + bare) : bare;
          location.replace(dest + location.search + location.hash);
        }
      })();

      // Force Astro's ClientRouter onto its plain-swap path in every browser.
      // The native View Transition API pauses/throttles the page's own rAF
      // ticks while it captures old/new snapshots — which stutters GSAP's
      // curtain tween (PageTransition.astro) mid-flight. Our curtain is the
      // only page-navigation transition this site needs, so the native one is
      // switched off for ClientRouter rather than raced against. (fallback="swap"
      // below still keeps ClientRouter's SPA routing + lifecycle events active —
      // fallback="none" would disable routing entirely once this API looks
      // unsupported.)
      //
      // ThemeToggle's own click-driven transition still needs the real API —
      // the reference is rescued onto window before nulling the document one,
      // so scripts/theme/view-transition.ts can call it directly without ever
      // touching document.startViewTransition (which stays permanently off).
      if ('startViewTransition' in document) {
        window.__nativeStartViewTransition = document.startViewTransition.bind(document);
        document.startViewTransition = undefined;
      }

      // Keep the selected theme stable across ClientRouter swaps.
      (function () {
        var DARK_META = '#1a1814';
        var LIGHT_META = '#f0ece1';

        var resolveTheme = function () {
          var stored = localStorage.getItem('theme');
          if (stored === 'dark' || stored === 'light') return stored;
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        };

        var applyTheme = function (doc) {
          var theme = resolveTheme();
          var root = doc.documentElement;
          var meta = doc.getElementById('theme-color-meta');
          var stored = localStorage.getItem('theme');

          root.setAttribute('data-theme', theme);
          root.style.colorScheme = stored === 'dark' || stored === 'light' ? stored : 'light dark';

          if (meta) {
            meta.setAttribute('content', theme === 'dark' ? DARK_META : LIGHT_META);
          }
        };

        if (!localStorage.getItem('theme')) localStorage.setItem('theme', 'auto');
        applyTheme(document);

        document.addEventListener('astro:before-swap', function (event) {
          if (event && event.newDocument) applyTheme(event.newDocument);
        });
        document.addEventListener('astro:after-swap', function () {
          applyTheme(document);
        });
      })();
    </script>
    <ClientRouter fallback="swap" />
  </head>

  <body>
    <a class="skip" href="#main">{ui.common.skipToContent}</a>

    <PageTransition />
    <ThemeTransitionOverlay />
    <Nav />

    <main id="main">
      <slot />
    </main>

    <script>
      import '../scripts/animate';
      import '../scripts/page-transition';
      import '../scripts/scroll-to-section';
      import '../scripts/theme/index';
    </script>

    <style>
      .skip {
        position: fixed;
        left: var(--edge);
        top: -4rem;
        z-index: 60;
        background: var(--ink);
        color: var(--paper);
        padding: 0.6em 1em;
        font-family: var(--font-mono);
        font-size: var(--step--1);
        transition: top var(--dur-1) var(--ease);
      }
      .skip:focus {
        top: var(--space-s);
      }
      @media (prefers-reduced-motion: reduce) {
        .skip { transition: none; }
      }
    </style>
  </body>
</html>
