---
// First-paint curtain — separate lifecycle from PageTransition's navigation
// curtain (src/components/organisms/PageTransition.astro). Runs once on a
// real document load only: src/scripts/initial-pixel-curtain.ts is a page
// <script>, which Astro's ClientRouter executes exactly once per real
// document (not re-run on client-side swaps), so no extra "has it run yet"
// flag is needed — the platform already guarantees it.
//
// Each panel IS the pixel layer (no separate solid-block + thin-fringe
// split) — same fullscreen clip-path cascade PageTransition uses, just
// applied to two half-viewport panels instead of one full one, so the
// "opens from the center" read comes purely from where the erosion starts.
//
// Fails open: hidden by default via CSS, only shown once the script confirms
// it initialized (adds [data-active]) — so a JS failure never leaves a
// permanent opaque overlay over the site. Purely decorative, so it's
// aria-hidden rather than exposed as a progress indicator.
---

<div class="pixel-curtain" data-pixel-curtain aria-hidden="true">
  <div class="pixel-curtain__panel pixel-curtain__panel--left" data-curtain-panel="left"></div>
  <div class="pixel-curtain__panel pixel-curtain__panel--right" data-curtain-panel="right"></div>
</div>

<noscript>
  <style>
    .pixel-curtain {
      display: none;
    }
  </style>
</noscript>

<style>
  .pixel-curtain {
    position: fixed;
    inset: 0;
    z-index: var(--z-initial-curtain);
    pointer-events: auto;
    overflow: hidden;
    contain: strict;
    display: none; /* fail-open default — shown only once JS marks [data-active] */
  }
  .pixel-curtain[data-active] {
    display: block;
  }
  .pixel-curtain[data-complete] {
    pointer-events: none;
  }

  /* Each panel is the pixel layer itself — solid at rest, eroded via an
     animated clip-path once opening starts (see initial-pixel-curtain.ts).
     No transform: the reveal comes entirely from the clip-path erosion. */
  .pixel-curtain__panel {
    position: absolute;
    top: 0;
    bottom: 0;
    height: 100dvh;
    width: calc(50% + 1px); /* 1px overlap at center — no subpixel seam */
    background: var(--ink);
  }
  .pixel-curtain__panel--left {
    left: 0;
  }
  .pixel-curtain__panel--right {
    right: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .pixel-curtain[data-opening] .pixel-curtain__panel {
      transition: opacity 160ms linear;
      opacity: 0;
    }
  }
</style>
