---
import SectionHeader from '../molecules/SectionHeader.astro';
import { getCV, t, resolveLocale } from '../../i18n';
const locale = resolveLocale(Astro.currentLocale);
const { certificates } = getCV(locale);
const ui = t(locale);

function validity(date: string, endDate?: string): string {
  const start = date.slice(0, 4);
  return endDate ? `${start} — ${endDate.slice(0, 4)}` : start;
}
---

<section class="certs shell" aria-labelledby="certifications-title">
  <SectionHeader index="06" id="certifications-title" title={ui.sections.certifications.title} kicker={ui.sections.certifications.kicker} axis="WGHT 500 · OPSZ 40" />

  <ol class="certs__grid">
    {certificates.map((c, i) => (
      <li class="certs__card" style={`--offset:${i % 2}`}>
        <div class="certs__top">
          <span class="certs__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="certs__valid label">{validity(c.date, c.endDate)}</span>
        </div>
        <h3 class="certs__name">{c.name}</h3>
        <p class="certs__issuer">{c.issuer}</p>
        <p class="certs__summary">{c.summary}</p>
        {(c.credentialId || c.url) && (
          <div class="certs__cred">
            {c.credentialId && <span class="certs__cred-id">{ui.certifications.credentialIdLabel} · {c.credentialId}</span>}
            {c.url && (
              <a class="certs__verify" href={c.url} target="_blank" rel="noopener noreferrer">
                {ui.certifications.verifyCredential}
                <svg viewBox="0 0 24 24" width="0.7em" height="0.7em" aria-hidden="true" focusable="false">
                  <path d="M7 17L17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            )}
          </div>
        )}
      </li>
    ))}
  </ol>
</section>

<style>
  .certs__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-l) var(--space-xl);
  }
  /* Broken grid: nudge alternating cards off a shared baseline, matching Stack.
     Separator weight matches the site-wide 1px --line rule used by every section. */
  .certs__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    border-top: 1px solid var(--line);
    padding-top: var(--space-s);
    margin-top: calc(var(--offset) * var(--space-m));
  }
  .certs__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
  }
  .certs__num {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.1em;
  }
  .certs__valid {
    color: var(--faint);
  }
  .certs__name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-variation-settings: 'opsz' 40, 'wght' 500, var(--wonk-off);
    line-height: 1.15;
    margin-top: var(--space-2xs);
  }
  .certs__issuer {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--accent-ink);
    letter-spacing: 0.02em;
  }
  .certs__summary {
    color: var(--muted);
    max-width: var(--measure-tight);
    margin-top: var(--space-2xs);
  }
  .certs__cred {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-s);
    margin-top: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
  .certs__cred-id {
    color: var(--faint);
    letter-spacing: 0.02em;
  }
  .certs__verify {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid var(--line);
    padding-bottom: 2px;
    transition: color var(--dur-1) var(--ease), border-color var(--dur-1) var(--ease);
  }
  .certs__verify:hover,
  .certs__verify:focus-visible {
    color: var(--accent-ink);
    border-color: var(--accent);
  }
  @media (max-width: 720px) {
    .certs__grid {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
    .certs__card {
      margin-top: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .certs__verify { transition: none; }
  }
</style>
