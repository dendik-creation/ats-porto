---
import ArrowLink from '../atoms/ArrowLink.astro';
import { getCV, t, resolveLocale } from '../../i18n';
const locale = resolveLocale(Astro.currentLocale);
const { basics } = getCV(locale);
const ui = t(locale);
const first = "Dendi'";
const last = 'Setiawan';
---

<header class="hero shell" data-hero>
  <div class="hero__bg" aria-hidden="true">
    <svg
      id="hero-background-svg"
      viewBox="0 0 1600 900"
      width="100%"
      height="100%"
      preserveAspectRatio="xMidYMid slice"
      role="presentation"
      focusable="false"
    >
      <defs>
        <pattern id="hero-bg-dotgrid" width="18" height="18" patternUnits="userSpaceOnUse">
          <circle class="hero-bg__dot" cx="1.5" cy="1.5" r="1.1" />
        </pattern>
      </defs>

      <g id="base-grid">
        <rect width="1600" height="900" fill="url(#hero-bg-dotgrid)" />
      </g>

      <g id="ink-paths" fill="none" stroke-linecap="round">
        <path
          class="hero-bg__path hero-bg__path--a"
          pathLength="240"
          d="M880,60 C1020,150 1120,90 1260,220 S1480,400 1400,540 S1180,700 1340,830"
        />
        <path
          class="hero-bg__path hero-bg__path--b"
          pathLength="240"
          d="M740,600 C890,510 1040,650 1170,560 S1400,470 1560,610"
        />
        <path
          class="hero-bg__path hero-bg__path--c"
          pathLength="240"
          d="M1080,860 C1230,790 1330,870 1500,800"
        />
        <path
          class="hero-bg__path hero-bg__path--d"
          pathLength="240"
          d="M140,560 C320,495 480,640 660,570 S900,480 1080,590"
        />
        <path
          class="hero-bg__path hero-bg__path--e"
          pathLength="240"
          d="M120,800 C360,725 560,860 800,780 S1180,700 1420,800"
        />
        <path
          class="hero-bg__path hero-bg__path--thin hero-bg__path--f"
          pathLength="240"
          d="M420,640 C560,700 700,660 820,730"
        />
        <path
          class="hero-bg__path hero-bg__path--swash"
          d="M1290,300 C1320,255 1395,258 1425,310 C1452,362 1408,430 1350,422 C1302,415 1278,352 1290,300 Z"
        />
        <path
          class="hero-bg__path hero-bg__path--swash hero-bg__path--swash-b"
          d="M630,580 C650,553 692,557 703,586 C713,614 686,637 659,629 C637,622 618,602 630,580 Z"
        />
      </g>

      <g id="vermillion-nodes">
        <circle class="hero-bg__node" cx="1260" cy="220" r="3.5" style="--pulse-delay:0s" />
        <circle class="hero-bg__node" cx="1400" cy="540" r="3.5" style="--pulse-delay:1.2s" />
        <circle class="hero-bg__node" cx="1170" cy="560" r="3.5" style="--pulse-delay:2.4s" />
        <circle class="hero-bg__node" cx="1500" cy="800" r="3.5" style="--pulse-delay:3.6s" />
        <circle class="hero-bg__node" cx="1350" cy="422" r="3.5" style="--pulse-delay:4.8s" />
        <circle class="hero-bg__node" cx="660" cy="570" r="3" style="--pulse-delay:0.8s" />
        <circle class="hero-bg__node" cx="480" cy="640" r="2.5" style="--pulse-delay:2s" />
        <circle class="hero-bg__node" cx="800" cy="780" r="3" style="--pulse-delay:3.2s" />
        <circle class="hero-bg__node" cx="1080" cy="590" r="2.5" style="--pulse-delay:5.4s" />
      </g>
    </svg>
  </div>

  <p class="hero__eyebrow label">
    <span>{basics.label}</span>
  </p>

  <h1 class="hero__name" aria-label={basics.name}>
    <span class="hero__word hero__word--first" aria-hidden="true">
      {first.split('').map((c, i) => <span class="hero__ch" style={`--i:${i}`}>{c}</span>)}
    </span>
    <span class="hero__word hero__word--last" aria-hidden="true">
      {last.split('').map((c, i) => <span class="hero__ch" style={`--i:${i}`}>{c}</span>)}
    </span>
  </h1>

  <p class="hero__spec" aria-hidden="true">
    <span>Fraunces Variable</span>
    <span class="hero__spec-sep">/</span>
    <span>WGHT 300 → 900</span>
    <span class="hero__spec-sep">/</span>
    <span>OPSZ 144</span>
    <span class="hero__spec-sep">/</span>
    <span>SOFT · WONK</span>
  </p>

  <div class="hero__bottom">
    <div class="hero__foot">
      <p class="hero__summary">{basics.summary}</p>
      <p class="hero__avail">
        <span class="hero__pulse" aria-hidden="true"></span>
        {ui.hero.availability}
      </p>
    </div>
    <div class="hero__cv">
      <ArrowLink href={basics.cvUrl} external>{ui.hero.viewCv}</ArrowLink>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-top: clamp(3.5rem, 8vh, 8rem);
    padding-bottom: var(--space-l);
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  /* Ambient background canvas — sits behind all hero content via negative
     z-index inside the .hero stacking context, never intercepts input. */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    /* Slower, more contemplative curve than --ease (tuned for UI feedback);
       this drives ambient motion only, never interaction response. */
    --hero-bg-ease: cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  #hero-background-svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero-bg__dot {
    fill: var(--ink);
    opacity: 0.07;
  }
  .hero-bg__path {
    stroke: var(--ink);
    stroke-width: 0.9;
    opacity: 0.52;
    stroke-dasharray: 60 180;
    animation: hero-bg-trace 44s var(--hero-bg-ease) infinite;
  }
  .hero-bg__path--a { animation-duration: 42s; }
  .hero-bg__path--b { animation-duration: 48s; animation-delay: -6s; }
  .hero-bg__path--c { animation-duration: 54s; animation-delay: -18s; stroke-width: 0.75; }
  .hero-bg__path--d { animation-duration: 50s; animation-delay: -10s; }
  .hero-bg__path--e { animation-duration: 58s; animation-delay: -24s; stroke-width: 0.75; }
  .hero-bg__path--thin {
    stroke-width: 0.6;
    opacity: 0.3;
    stroke-dasharray: 30 90;
  }
  .hero-bg__path--f { animation-duration: 36s; animation-delay: -14s; }
  .hero-bg__path--swash {
    fill: var(--accent);
    stroke: none;
    opacity: 0.06;
  }
  .hero-bg__path--swash-b {
    fill: var(--ink);
    opacity: 0.05;
  }
  .hero-bg__node {
    fill: var(--accent);
    opacity: 0.2;
    animation: hero-bg-pulse 6s var(--hero-bg-ease) infinite;
    animation-delay: var(--pulse-delay, 0s);
  }

  @keyframes hero-bg-trace {
    from { stroke-dashoffset: 0; }
    to { stroke-dashoffset: -240; }
  }
  @keyframes hero-bg-pulse {
    0%, 100% { opacity: 0.2; r: 3.5; }
    50% { opacity: 0.9; r: 5; }
  }
  .hero__eyebrow {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9em;
    align-items: center;
  }

  /* Concrete-poetry name: broken baseline, offset words, per-letter weight ramp */
  .hero__name {
    margin: 0;
    display: flex;
    flex-direction: column;
    line-height: 0.82;
    letter-spacing: -0.03em;
  }
  .hero__word {
    display: block;
    max-width: 100%;
    font-family: var(--font-display);
    /* Sized so the longest word ("setiawan") fits within the gutter at 360px */
    font-size: clamp(2.75rem, 16vw, 12rem);
    text-transform: lowercase;
  }
  .hero__word--last {
    align-self: flex-end;
    text-align: right;
    color: var(--accent);
  }
  .hero__ch {
    display: inline-block;
    /* Weight ramps across the word for a poster-like typographic gradient */
    font-variation-settings:
      'opsz' 144,
      'wght' calc(300 + var(--i) * 90),
      'SOFT' 0, 'WONK' 0;
    transition: font-variation-settings var(--dur-2) var(--ease);
  }
  .hero__word--last .hero__ch {
    font-variation-settings:
      'opsz' 144,
      'wght' calc(680 - var(--i) * 70),
      'SOFT' 40, 'WONK' 1;
  }
  .hero__ch:hover {
    font-variation-settings: 'opsz' 144, 'wght' 900, 'SOFT' 100, 'WONK' 1;
  }
  /* Last word's base rule outranks the shared :hover, so it needs its own —
     same axis jump as the first word; color and position stay untouched. */
  .hero__word--last .hero__ch:hover {
    font-variation-settings: 'opsz' 144, 'wght' 900, 'SOFT' 100, 'WONK' 1;
  }

  .hero__spec {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em 0.9em;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
    padding-top: var(--space-2xs);
    border-top: 1px solid var(--line);
    margin-top: var(--space-2xs);
  }
  .hero__spec-sep {
    color: var(--accent);
  }

  .hero__bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-m);
    margin-top: var(--space-s);
  }
  .hero__foot {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-s);
    max-width: 54ch;
    text-align: right;
  }
  .hero__summary {
    font-size: var(--step-1);
    color: var(--ink);
    font-variation-settings: 'wght' 380;
    line-height: 1.4;
    text-wrap: pretty;
  }
  .hero__avail {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    justify-content: flex-end;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    color: var(--muted);
  }
  .hero__cv {
    flex: none;
    order: -1;
  }
  .hero__pulse {
    width: 0.6em;
    height: 0.6em;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 color-mix(in oklab, var(--accent) 60%, transparent);
    animation: ring 2.6s var(--ease) infinite;
  }

  @keyframes ring {
    0% { box-shadow: 0 0 0 0 color-mix(in oklab, var(--accent) 55%, transparent); }
    70% { box-shadow: 0 0 0 0.7em transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  @media (max-width: 720px) {
    /* Mobile stacks the hero into one dense text column — no negative-space
       quadrant left for the linework to occupy without crossing copy. Keep
       only the ambient paper texture. */
    .hero-bg__path,
    .hero-bg__node {
      display: none;
    }
    .hero__word--last {
      align-self: flex-start;
      text-align: left;
    }
    .hero__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-s);
    }
    .hero__foot {
      text-align: left;
    }
    .hero__avail {
      justify-content: flex-start;
    }
    .hero__cv {
      order: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__ch { transition: none; }
    .hero__pulse { animation: none; }
    .hero-bg__path,
    .hero-bg__node { animation: none; }
  }
</style>
