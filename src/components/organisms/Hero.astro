---
import ArrowLink from '../atoms/ArrowLink.astro';
import { getCV, t, resolveLocale } from '../../i18n';
const locale = resolveLocale(Astro.currentLocale);
const { basics } = getCV(locale);
const ui = t(locale);
const first = "Dendi'";
const last = 'Setiawan';
---

<header class="hero shell" data-hero>
  <div class="hero__bg" aria-hidden="true">
    <svg
      id="hero-background-svg"
      viewBox="0 0 1600 900"
      width="100%"
      height="100%"
      preserveAspectRatio="xMidYMid slice"
      role="presentation"
      focusable="false"
    >
      <defs>
        <pattern id="hero-bg-dotgrid" width="18" height="18" patternUnits="userSpaceOnUse">
          <circle class="hero-bg__dot" cx="1.5" cy="1.5" r="1.1" />
        </pattern>
      </defs>

      <g id="base-grid">
        <rect width="1600" height="900" fill="url(#hero-bg-dotgrid)" />
      </g>

      <g id="ink-paths" fill="none" stroke-linecap="round">
        <path
          class="hero-bg__path hero-bg__path--a"
          pathLength="240"
          d="M880,60 C1020,150 1120,90 1260,220 S1480,400 1400,540 S1180,700 1340,830"
        />
        <path
          class="hero-bg__path hero-bg__path--b"
          pathLength="240"
          d="M740,600 C890,510 1040,650 1170,560 S1400,470 1560,610"
        />
        <path
          class="hero-bg__path hero-bg__path--c"
          pathLength="240"
          d="M1080,860 C1230,790 1330,870 1500,800"
        />
        <path
          class="hero-bg__path hero-bg__path--d"
          pathLength="240"
          d="M140,560 C320,495 480,640 660,570 S900,480 1080,590"
        />
        <path
          class="hero-bg__path hero-bg__path--e"
          pathLength="240"
          d="M120,800 C360,725 560,860 800,780 S1180,700 1420,800"
        />
        <path
          class="hero-bg__path hero-bg__path--thin hero-bg__path--f"
          pathLength="240"
          d="M420,640 C560,700 700,660 820,730"
        />
        <path
          class="hero-bg__path hero-bg__path--swash"
          d="M1290,300 C1320,255 1395,258 1425,310 C1452,362 1408,430 1350,422 C1302,415 1278,352 1290,300 Z"
        />
        <path
          class="hero-bg__path hero-bg__path--swash hero-bg__path--swash-b"
          d="M630,580 C650,553 692,557 703,586 C713,614 686,637 659,629 C637,622 618,602 630,580 Z"
        />
      </g>

      <g id="vermillion-nodes">
        <circle class="hero-bg__node" cx="1260" cy="220" r="3.5" style="--pulse-delay:0s" />
        <circle class="hero-bg__node" cx="1400" cy="540" r="3.5" style="--pulse-delay:1.2s" />
        <circle class="hero-bg__node" cx="1170" cy="560" r="3.5" style="--pulse-delay:2.4s" />
        <circle class="hero-bg__node" cx="1500" cy="800" r="3.5" style="--pulse-delay:3.6s" />
        <circle class="hero-bg__node" cx="1350" cy="422" r="3.5" style="--pulse-delay:4.8s" />
        <circle class="hero-bg__node" cx="660" cy="570" r="3" style="--pulse-delay:0.8s" />
        <circle class="hero-bg__node" cx="480" cy="640" r="2.5" style="--pulse-delay:2s" />
        <circle class="hero-bg__node" cx="800" cy="780" r="3" style="--pulse-delay:3.2s" />
        <circle class="hero-bg__node" cx="1080" cy="590" r="2.5" style="--pulse-delay:5.4s" />
      </g>
    </svg>
  </div>

  <div class="hero__content">
    <div class="hero__top">
      <p class="hero__eyebrow label">{basics.label}</p>
      <p class="hero__avail">
        <span class="hero__pulse" aria-hidden="true"></span>
        {ui.hero.availability}
      </p>
    </div>

    <div class="hero__bottom">
      <h1 class="hero__name" aria-label={basics.name}>
        <span class="hero__word hero__word--first" aria-hidden="true">
          {first.split('').map((c, i) => <span class="hero__ch" style={`--i:${i}`}>{c}</span>)}
        </span>
        <span class="hero__word hero__word--last" aria-hidden="true">
          {last.split('').map((c, i) => <span class="hero__ch" style={`--i:${i}`}>{c}</span>)}
        </span>
      </h1>

      <!-- Own grid row, above .hero__foot — a bounded slot, not a full-hero
           overlay, so the keyboard can never share paint area with the
           description (see this file's own <script> for the entrance). -->
      <div class="hero__visual-slot" aria-hidden="true">
        <div class="hero__keyboard-depth" data-hero-keyboard>
          <img
            class="hero__keyboard"
            src="/static/arc/hero-section.webp"
            alt=""
            width="2018"
            height="779"
            decoding="async"
            fetchpriority="high"
          />
          <span class="hero__keyboard-shadow"></span>
        </div>
      </div>

      <div class="hero__foot">
        <p class="hero__summary">{basics.summary}</p>
        <div class="hero__cv">
          <ArrowLink href={basics.cvUrl} external>{ui.hero.viewCv}</ArrowLink>
        </div>
      </div>
    </div>

    <p class="hero__spec" aria-hidden="true">
      <span>Fraunces Variable</span>
      <span class="hero__spec-sep">/</span>
      <span>WGHT 300 → 900</span>
      <span class="hero__spec-sep">/</span>
      <span>OPSZ 144</span>
      <span class="hero__spec-sep">/</span>
      <span>SOFT · WONK</span>
    </p>
  </div>
</header>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    box-sizing: border-box;
    /* Horizontal only — vertical overflow must stay visible or the idle
       keyboard drift and its own shadow can clip against this box. */
    overflow-x: hidden;
    overflow-x: clip;
    /* A full-viewport-height hero regardless of the (now much shorter, text-
       only) in-flow content — the keyboard is a grid item sized by its own
       slot, not something Hero's height can lean on. */
    min-height: 100svh;
    min-height: 100dvh;
    padding-top: var(--nav-h);
    padding-bottom: var(--space-l);
    display: flex;
    flex-direction: column;
  }

  /* Balanced breathing room above/below inside the now viewport-tall .hero —
     margin-block:auto centers this one flex child along .hero's main axis. */
  .hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    margin-block: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  /* Ambient background canvas — sits behind all hero content via negative
     z-index inside the .hero stacking context, never intercepts input. */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    /* Slower, more contemplative curve than --ease (tuned for UI feedback);
       this drives ambient motion only, never interaction response. */
    --hero-bg-ease: cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  #hero-background-svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero-bg__dot {
    fill: var(--ink);
    opacity: 0.07;
  }
  .hero-bg__path {
    stroke: var(--ink);
    stroke-width: 0.9;
    opacity: 0.52;
    stroke-dasharray: 60 180;
    animation: hero-bg-trace 44s var(--hero-bg-ease) infinite;
  }
  .hero-bg__path--a { animation-duration: 42s; }
  .hero-bg__path--b { animation-duration: 48s; animation-delay: -6s; }
  .hero-bg__path--c { animation-duration: 54s; animation-delay: -18s; stroke-width: 0.75; }
  .hero-bg__path--d { animation-duration: 50s; animation-delay: -10s; }
  .hero-bg__path--e { animation-duration: 58s; animation-delay: -24s; stroke-width: 0.75; }
  .hero-bg__path--thin {
    stroke-width: 0.6;
    opacity: 0.3;
    stroke-dasharray: 30 90;
  }
  .hero-bg__path--f { animation-duration: 36s; animation-delay: -14s; }
  .hero-bg__path--swash {
    fill: var(--accent);
    stroke: none;
    opacity: 0.06;
  }
  .hero-bg__path--swash-b {
    fill: var(--ink);
    opacity: 0.05;
  }
  .hero-bg__node {
    fill: var(--accent);
    opacity: 0.2;
    animation: hero-bg-pulse 6s var(--hero-bg-ease) infinite;
    animation-delay: var(--pulse-delay, 0s);
  }

  @keyframes hero-bg-trace {
    from { stroke-dashoffset: 0; }
    to { stroke-dashoffset: -240; }
  }
  @keyframes hero-bg-pulse {
    0%, 100% { opacity: 0.2; r: 3.5; }
    50% { opacity: 0.9; r: 5; }
  }
  .hero__top {
    display: flex;
    flex-wrap: wrap;
    margin-top: var(--space-xs);
    justify-content: space-between;
    align-items: center;
    gap: var(--space-s);
  }
  .hero__eyebrow {
    margin: 0;
  }

  /* Bounded slot, not a full-hero overlay — a real grid cell the keyboard
     is sized/clipped against, so it can never spill into .hero__foot's row
     or past the column edge. One asset works for both themes (transparent
     background, ink linework already carries the ivory/graphite/accent
     palette), so there's no swap-on-theme-change to guard against. */
  .hero__visual-slot {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    min-width: 0;
    min-height: 14rem;
    padding: clamp(0.5rem, 1vw, 1.25rem);
    overflow: visible;
    pointer-events: none;
    user-select: none;
  }

  /* Entrance + perspective live here; idle drift lives one level down on
     .hero__keyboard so the two transforms never overwrite each other. Only
     transform/opacity/filter ever animate — no top/right/width, so the
     rendered box (and its safe margin to the slot's own edge) never moves.
     The 100% cap (not the rem figure) is what actually governs on desktop —
     the column itself is narrower than 52rem at every real viewport, so this
     just removes slot padding as the only thing holding the render back. */
  .hero__keyboard-depth {
    position: relative;
    width: min(100%, 52rem);
    max-width: 100%;
    margin-inline: auto;
    transform-origin: center;
    transform-style: preserve-3d;
    transform: perspective(1200px) rotateX(3deg) rotateY(-4deg) rotateZ(-2deg) scale(0.94);
  }
  .hero__keyboard {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    object-fit: contain;
    animation: hero-keyboard-idle 7.5s ease-in-out infinite alternate;
    animation-delay: 1.6s;
  }
  @keyframes hero-keyboard-idle {
    from { transform: translateY(0) rotateZ(0deg); }
    to { transform: translateY(-5px) rotateZ(0.6deg); }
  }

  /* Cross-hatch-style ground shadow, not a soft modern drop-shadow — same
     var(--ink)-plus-opacity wash .hero-bg__path already uses above. Sits
     inside .hero__keyboard-depth's own stacking context (its transform
     creates one), so z-index:-1 only ever tucks it behind the keyboard img,
     never behind unrelated siblings like .hero__foot. */
  .hero__keyboard-shadow {
    position: absolute;
    left: 12%;
    right: 12%;
    bottom: 4%;
    height: 12%;
    z-index: -1;
    opacity: 0.14;
    background: repeating-linear-gradient(90deg, var(--ink) 0 3px, transparent 3px 7px);
    filter: blur(8px);
  }

  /* Three real areas, not one row with a keyboard stacked behind it: name
     spans the full left column; the keyboard and description are separate
     grid ROWS in the right column, so they can never occupy the same
     paint area — no z-index trick required to keep them apart. */
  .hero__bottom {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 1fr);
    grid-template-rows: auto auto;
    column-gap: var(--space-l);
    row-gap: var(--space-s);
  }
  .hero__name {
    grid-column: 1;
    grid-row: 1 / 3;
    align-self: end;
  }
  .hero__visual-slot {
    grid-column: 2;
    grid-row: 1;
  }
  .hero__foot {
    grid-column: 2;
    grid-row: 2;
    align-self: start;
  }

  /* Concrete-poetry name: broken baseline, offset words, per-letter weight ramp */
  .hero__name {
    margin: 0;
    display: flex;
    flex-direction: column;
    line-height: 0.82;
    letter-spacing: -0.03em;
    /* Size words off this column's own width, not the viewport — the name
       shares the row with .hero__foot, so it never gets the full shell. */
    container-type: inline-size;
  }
  .hero__word {
    display: block;
    max-width: 100%;
    font-family: var(--font-display);
    /* cqi = share of the name column's width, so the longest word ("setiawan")
       always fits on one line whether the column is the full shell (mobile,
       stacked) or half of it (desktop, beside .hero__foot). */
    font-size: clamp(2.75rem, 19cqi, 9rem);
    text-transform: lowercase;
  }
  .hero__word--last {
    align-self: flex-end;
    text-align: right;
    color: var(--accent);
  }
  .hero__ch {
    display: inline-block;
    /* Weight ramps across the word for a poster-like typographic gradient */
    font-variation-settings:
      'opsz' 144,
      'wght' calc(300 + var(--i) * 90),
      'SOFT' 0, 'WONK' 0;
    transition: font-variation-settings var(--dur-2) var(--ease);
  }
  .hero__word--last .hero__ch {
    font-variation-settings:
      'opsz' 144,
      'wght' calc(680 - var(--i) * 70),
      'SOFT' 40, 'WONK' 1;
  }
  .hero__ch:hover {
    font-variation-settings: 'opsz' 144, 'wght' 900, 'SOFT' 100, 'WONK' 1;
  }
  /* Last word's base rule outranks the shared :hover, so it needs its own —
     same axis jump as the first word; color and position stay untouched. */
  .hero__word--last .hero__ch:hover {
    font-variation-settings: 'opsz' 144, 'wght' 900, 'SOFT' 100, 'WONK' 1;
  }

  .hero__spec {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em 0.9em;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
    padding-top: var(--space-2xs);
    border-top: 1px solid var(--line);
    margin-top: var(--space-2xs);
  }
  .hero__spec-sep {
    color: var(--accent);
  }

  .hero__foot {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xs);
    max-width: 48ch;
    padding-bottom: var(--space-2xs);
  }
  .hero__summary {
    font-size: var(--step-0);
    color: var(--ink);
    font-variation-settings: 'wght' 380;
    line-height: 1.5;
    text-wrap: pretty;
  }
  .hero__avail {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    color: var(--muted);
  }
  .hero__cv {
    margin-top: var(--space-2xs);
  }
  .hero__pulse {
    width: 0.6em;
    height: 0.6em;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 color-mix(in oklab, var(--accent) 60%, transparent);
    animation: ring 2.6s var(--ease) infinite;
  }

  @keyframes ring {
    0% { box-shadow: 0 0 0 0 color-mix(in oklab, var(--accent) 55%, transparent); }
    70% { box-shadow: 0 0 0 0.7em transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  /* Tablet: the 1.2fr/1fr split gets too cramped for a real keyboard render
     before the phone breakpoint below — collapse to one column here instead
     of squeezing it. Order stays name → keyboard → description (source
     order already matches; only the explicit column/row placement needs
     resetting to auto). */
  @media (max-width: 1024px) {
    .hero__bottom {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      gap: var(--space-m);
    }
    .hero__name,
    .hero__visual-slot,
    .hero__foot {
      grid-column: 1;
      grid-row: auto;
    }
    .hero__name {
      align-self: auto;
    }
    .hero__foot {
      align-self: auto;
    }
  }

  @media (max-width: 720px) {
    /* Mobile stacks the hero into one dense text column — no negative-space
       quadrant left for the linework to occupy without crossing copy. Keep
       only the ambient paper texture. */
    .hero-bg__path,
    .hero-bg__node {
      display: none;
    }
    .hero__word--last {
      align-self: flex-start;
      text-align: left;
    }
    .hero__bottom {
      gap: var(--space-s);
    }
    .hero__foot {
      max-width: none;
    }

    /* Full opacity, same as desktop — the slot still bounds it, so nothing
       gets cropped. */
    .hero__visual-slot {
      min-height: 9rem;
      padding-inline: 0.75rem;
    }
    .hero__keyboard-depth {
      width: min(28rem, 100%);
      transform: perspective(900px) rotateX(3deg) rotateY(-3deg) rotateZ(-2deg) scale(0.92);
    }
    .hero__keyboard {
      animation: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__ch { transition: none; }
    .hero__pulse { animation: none; }
    .hero-bg__path,
    .hero-bg__node { animation: none; }
    .hero__keyboard-depth,
    .hero__keyboard {
      animation: none;
      transition: none;
    }
    .hero__keyboard-depth {
      opacity: 1;
      filter: none;
    }
  }
</style>

<script>
  // Pixelate-in entrance, same Pixel Motion System every other reveal on the
  // site uses (Nav, Lightbox, project images) — fired once, at the same beat
  // the old mask-based reveal used to fire on ('hero-stage-reveal', dispatched
  // by scripts/animate.ts's GSAP timeline). No theme-swap handling needed —
  // one asset serves both themes, so data-theme flips never touch this element.
  import { buildPixelPlan, buildClipKeyframes, resolveTileSize, prefersReducedMotion, PIXEL_EASE } from '../../scripts/pixel-transition';

  const DESKTOP_TILE = 22;
  const MOBILE_TILE = 16;
  const BUCKETS = 30;
  const DURATION_MS = 900;

  function setup(): void {
    const depth = document.querySelector<HTMLElement>('[data-hero-keyboard]');
    if (!depth) return; // hero isn't on this page
    if (prefersReducedMotion()) return; // resting CSS state is already the final one

    // offsetWidth/Height, not getBoundingClientRect — .hero__keyboard-depth
    // carries its own permanent rotate/scale, and clip-path is defined in an
    // element's own pre-transform local box regardless of that transform.
    const width = depth.offsetWidth;
    const height = depth.offsetHeight;
    if (width <= 0 || height <= 0) return;

    const tileSize = resolveTileSize(DESKTOP_TILE, MOBILE_TILE);
    const plan = buildPixelPlan({ width, height, origin: { x: width, y: 0 }, tileSize });
    const keyframes = buildClipKeyframes(plan, { buckets: BUCKETS });

    // Hidden the instant this runs (well before the GSAP-timed event below
    // fires) so there's no flash of the finished keyboard beforehand.
    depth.style.clipPath = keyframes[0].clipPath as string;

    const onReveal = () => {
      const anim = depth.animate(keyframes, { duration: DURATION_MS, easing: PIXEL_EASE, fill: 'forwards' });
      anim.finished
        .then(() => {
          depth.style.clipPath = ''; // no inline style left behind once settled
          anim.cancel();
        })
        .catch(() => undefined);
    };
    document.addEventListener('hero-stage-reveal', onReveal, { once: true });
  }

  document.addEventListener('astro:page-load', setup);
</script>
