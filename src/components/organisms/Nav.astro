---
// Staggered slide-in menu — an Astro adaptation of the React Bits StaggeredMenu
// (https://reactbits.dev/components/staggered-menu). Re-skinned to the hallmark
// palette/type. Open state is a single [data-open] attribute; the stagger is
// pure CSS (per-item transition-delay), so it works with no framework, degrades
// without JS, and respects reduced-motion.
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getCV, t, resolveLocale } from '../../i18n';
import ThemeToggle from '../molecules/ThemeToggle.astro';

const locale = resolveLocale(Astro.currentLocale);
const { basics } = getCV(locale);
const ui = t(locale);
const home = getRelativeLocaleUrl(locale, '/');

const items = [
  { label: ui.nav.items.about, link: `${home}#about-title`, ariaLabel: ui.nav.ariaLabels.about },
  { label: ui.nav.items.stack, link: `${home}#skills-title`, ariaLabel: ui.nav.ariaLabels.stack },
  { label: ui.nav.items.work, link: `${home}#projects-title`, ariaLabel: ui.nav.ariaLabels.work },
  { label: ui.nav.items.allProjects, link: getRelativeLocaleUrl(locale, '/projects'), ariaLabel: ui.nav.ariaLabels.allProjects },
  { label: ui.nav.items.experience, link: `${home}#experience-title`, ariaLabel: ui.nav.ariaLabels.experience },
  { label: ui.nav.items.volunteer, link: `${home}#volunteer-title`, ariaLabel: ui.nav.ariaLabels.volunteer },
  { label: ui.nav.items.certifications, link: `${home}#certifications-title`, ariaLabel: ui.nav.ariaLabels.certifications },
  { label: ui.nav.items.languages, link: `${home}#languages-title`, ariaLabel: ui.nav.ariaLabels.languages },
  { label: ui.nav.items.contact, link: `${home}#contact-title`, ariaLabel: ui.nav.ariaLabels.contact },
  {
    label: ui.nav.items.visitors,
    link: 'https://cloud.umami.is/share/132aI2gdoyz9vhLj',
    ariaLabel: ui.nav.ariaLabels.visitors,
    external: true,
  },
];
const socials = basics.profiles.map((p) => ({ label: p.network, link: p.url }));
---

<div class="nav" data-nav>
  <div class="sm-bar" aria-hidden="true"></div>

  <header class="sm-header">
    <a class="sm-logo" href={`${home}#main`}>
      <img
        class="sm-logo-mark sm-logo-mark--light"
        src="/logo_in_light.webp"
        alt=""
        aria-hidden="true"
        width="321"
        height="358"
        style="height:clamp(1.8rem, 1.5rem + 1.2vw, 2.4rem); width:auto;"
      />
      <img
        class="sm-logo-mark sm-logo-mark--dark"
        src="/logo_in_dark.webp"
        alt=""
        aria-hidden="true"
        width="322"
        height="358"
        style="height:clamp(1.8rem, 1.5rem + 1.2vw, 2.4rem); width:auto;"
      />
      <span class="visually-hidden">{ui.nav.homeAria(basics.name)}</span>
    </a>

    <div class="sm-header-controls">
      <ThemeToggle toDarkLabel={ui.nav.theme.toggleToDark} toLightLabel={ui.nav.theme.toggleToLight} />

      <button
        class="sm-toggle"
        type="button"
        aria-label={ui.nav.openMenuAria}
        aria-expanded="false"
        aria-controls="staggered-menu-panel"
        data-open-label={ui.nav.openMenuAria}
        data-close-label={ui.nav.closeMenuAria}
      >
        <span class="sm-toggle-textWrap" aria-hidden="true">
          <span class="sm-toggle-textInner">
            <span class="sm-toggle-line">{ui.nav.menuLabel}</span>
            <span class="sm-toggle-line">{ui.nav.closeLabel}</span>
          </span>
        </span>
        <span class="sm-icon" aria-hidden="true">
          <span class="sm-icon-line"></span>
          <span class="sm-icon-line sm-icon-line-v"></span>
        </span>
      </button>
    </div>
  </header>

  <div class="sm-ghost" data-nav-ghost aria-hidden="true"></div>

  <aside id="staggered-menu-panel" class="sm-panel" aria-label="Menu" aria-hidden="true">
    {Array.from({ length: 4 }).map((_, i) => (
      <span class="sm-pixel opacity-0" data-sm-pixel={i} aria-hidden="true"></span>
    ))}
    <div class="sm-panel-inner">
      <ul class="sm-panel-list" data-numbering role="list">
        {items.map((it) => (
          <li class="sm-panel-itemWrap">
            <a
              class="sm-panel-item"
              href={it.link}
              aria-label={it.ariaLabel}
              target={it.external ? '_blank' : undefined}
              rel={it.external ? 'noopener noreferrer' : undefined}
            >
              <span class="sm-panel-itemLabel">{it.label}</span>
            </a>
          </li>
        ))}
      </ul>

      {socials.length > 0 && (
        <div class="sm-socials" aria-label="Social links">
          <h3 class="sm-socials-title">{ui.nav.elsewhere}</h3>
          <ul class="sm-socials-list" role="list">
            {socials.map((s) => (
              <li class="sm-socials-item">
                <a class="sm-socials-link" href={s.link} target="_blank" rel="noopener noreferrer">{s.label}</a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="sm-lang">
        <h3 class="sm-lang-title">{ui.nav.language.title}</h3>
        <div class="sm-lang-toggle" role="radiogroup" aria-label={ui.nav.language.title}>
          <a class="sm-lang-btn" data-lang-val="en" role="radio" aria-checked={locale === 'en'} href={getRelativeLocaleUrl('en', Astro.url.pathname.replace(/^\/id(?=\/|$)/, '') || '/')}>EN</a>
          <a class="sm-lang-btn" data-lang-val="id" role="radio" aria-checked={locale === 'id'} href={getRelativeLocaleUrl('id', Astro.url.pathname.replace(/^\/id(?=\/|$)/, '') || '/')}>ID</a>
        </div>
      </div>
    </div>
  </aside>

  <noscript>
    <ul class="sm-fallback">
      {items.map((it) => (
        <li>
          <a href={it.link} target={it.external ? '_blank' : undefined} rel={it.external ? 'noopener noreferrer' : undefined}>
            {it.label}
          </a>
        </li>
      ))}
    </ul>
  </noscript>
</div>

<style>
  /* Fixed overlay; transparent + click-through except its interactive children */
  .nav {
    position: fixed;
    inset: 0;
    z-index: 40;
    pointer-events: none;
  }

  /* ---- Top bar background (its own layer, below the panel) ---- */
  .sm-bar {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--nav-h);
    pointer-events: none;
    z-index: 15;
    /* Transparent over the first viewport; a paper bar fades in once scrolled */
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background var(--dur-1) var(--ease), border-color var(--dur-1) var(--ease);
  }
  .nav[data-scrolled] .sm-bar,
  .nav[data-open] .sm-bar {
    background: color-mix(in oklab, var(--paper) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .nav[data-scrolled] .sm-bar {
    border-bottom-color: var(--line);
  }

  /* ---- Top bar controls (above the panel so the toggle always closes it) ---- */
  .sm-header {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    min-height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding: var(--space-s) var(--edge);
    pointer-events: none;
    z-index: 45;
  }
  .sm-header > * {
    pointer-events: auto;
  }
  .sm-header-controls {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }
  .sm-logo {
    display: inline-flex;
    align-items: center;
  }
  .sm-logo-mark {
    height: clamp(1.8rem, 1.5rem + 1.2vw, 2.4rem);
    width: auto;
    transition: transform var(--dur-2) var(--ease);
  }
  .sm-logo:hover .sm-logo-mark {
    transform: scale(1.06);
  }
  /* Theme-scoped pair, same show/hide-by-attribute technique as the rest of
     the site's light/dark swaps — no JS, flips instantly with data-theme. */
  .sm-logo-mark--dark {
    display: none;
  }
  :root[data-theme='dark'] .sm-logo-mark--light {
    display: none;
  }
  :root[data-theme='dark'] .sm-logo-mark--dark {
    display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    .sm-logo-mark {
      transition: none;
    }
  }

  .sm-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    background: transparent;
    border: 0;
    cursor: pointer;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--step-0);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
    overflow: visible;
  }
  .sm-toggle-textWrap {
    position: relative;
    display: inline-block;
    height: 1em;
    overflow: hidden;
    white-space: nowrap;
  }
  .sm-toggle-textInner {
    display: flex;
    flex-direction: column;
    line-height: 1;
    transition: transform var(--dur-1) var(--ease);
  }
  .sm-toggle-line {
    display: block;
    height: 1em;
    line-height: 1;
  }
  .nav[data-open] .sm-toggle-textInner {
    transform: translateY(-50%);
  }

  .sm-icon {
    position: relative;
    width: 18px;
    height: 18px;
    flex: 0 0 18px;
    display: inline-flex;
  }
  .sm-icon-line {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 100%;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transform: translate(-50%, -50%) rotate(0deg);
    transition: transform var(--dur-1) var(--ease);
  }
  .sm-icon-line-v {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  .nav[data-open] .sm-icon-line { transform: translate(-50%, -50%) rotate(45deg); }
  .nav[data-open] .sm-icon-line-v { transform: translate(-50%, -50%) rotate(135deg); }

  /* ---- Panel ----
     Reveal is a Pixel Cascade clip-path (see nav.ts), not a slide — the
     panel never translates, it just materializes/consumes in place. The
     resting clip-path here is the pre-JS / closed baseline: fully collapsed
     to a zero-width sliver at the right edge, functionally invisible. */
  .sm-panel {
    position: absolute;
    top: 0;
    right: 0;
    width: clamp(280px, 42vw, 460px);
    height: 100%;
    background: var(--paper);
    display: flex;
    flex-direction: column;
    padding: calc(var(--nav-h) + var(--space-s)) var(--space-m) var(--space-m);
    overflow-y: hidden;
    clip-path: inset(0 0 0 100%);
    visibility: hidden;
    z-index: 30;
    pointer-events: auto;
    border-left: 1px solid var(--line-strong);
    /* Size the menu items relative to the panel width, not the viewport */
    container-type: inline-size;
  }
  /* Ghost layer — same rect as .sm-panel, one z-index behind it, painted in
     the OPPOSITE theme's paper/ink for the duration of the menu's pixel
     transition only (see nav script: it leads on open, lags on close so a
     band of opposite-theme color is visible at the advancing/retreating
     edge before the real, current-theme panel catches up). Never touches
     :root[data-theme] — colors below are restated from tokens.css's
     :root / :root[data-theme='dark'] blocks (kept in sync with those), not
     a new palette. Always pointer-events: none; purely decorative. */
  .sm-ghost {
    position: absolute;
    top: 0;
    right: 0;
    width: clamp(280px, 42vw, 460px);
    height: 100%;
    background: #1a1814;
    color: #e8e2d3;
    clip-path: inset(0 0 0 100%);
    visibility: hidden;
    z-index: 29;
    pointer-events: none;
  }
  :root[data-theme='dark'] .sm-ghost {
    background: #f0ece1;
    color: #14130f;
  }

  /* Boundary accent trail for the panel's pixel reveal — same reused-node
     technique as ThemeTransitionOverlay's .tt-pixel: a handful of hard-edged
     squares flashed along the cascade edge, never one node per tile. The
     panel's own paper background nearly matches the page behind it, so
     without this the wave itself is hard to perceive. */
  .sm-pixel {
    position: absolute;
    width: 20px;
    height: 20px;
    background: var(--accent);
    border-radius: 0;
    pointer-events: none;
    z-index: 31;
  }
  .sm-panel-inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    min-height: 0;
  }
  .sm-panel-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }
  .sm-panel-itemWrap {
    position: relative;
    overflow: hidden;
    line-height: 1;
    padding-right: 1.8em; /* reserved column for the running number */
  }
  .sm-panel-item {
    position: relative;
    display: inline-block;
    max-width: 100%;
    color: var(--ink);
    font-family: var(--font-display);
    /* cqi = share of the panel width, so long labels never overflow the panel */
    font-size: clamp(1.45rem, 10cqi, 2.6rem);
    font-variation-settings: 'opsz' 60, 'wght' 500, var(--wonk-off);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: color var(--dur-1) var(--ease), font-variation-settings var(--dur-2) var(--ease);
  }
  .sm-panel-itemLabel {
    display: inline-block;
  }
  .sm-panel-item:hover,
  .sm-panel-item:focus-visible {
    color: var(--accent-ink);
    font-variation-settings: 'opsz' 72, 'wght' 620, var(--wonk-on);
  }
  .sm-panel-list[data-numbering] {
    counter-reset: smItem;
  }
  /* Number sits in the wrap's reserved column (panel edge), not the item's own
     right edge — so it stays inside the panel regardless of label length. */
  .sm-panel-list[data-numbering] .sm-panel-itemWrap {
    counter-increment: smItem;
  }
  .sm-panel-list[data-numbering] .sm-panel-itemWrap::after {
    content: counter(smItem, decimal-leading-zero);
    position: absolute;
    top: 0.4em;
    right: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--accent);
    pointer-events: none;
    user-select: none;
  }

  /* ---- Socials ---- */
  .sm-socials {
    margin-top: auto;
    padding-top: var(--space-s);
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .sm-socials-title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .sm-socials-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
  }
  .sm-socials-link {
    font-family: var(--font-mono);
    font-size: var(--step-0);
    color: var(--ink);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid var(--line);
    transition: color var(--dur-1) var(--ease), border-color var(--dur-1) var(--ease);
  }
  .sm-socials-link:hover,
  .sm-socials-link:focus-visible {
    color: var(--accent-ink);
    border-color: var(--accent);
  }

  /* ---- Language switcher ---- */
  .sm-lang {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .sm-lang-title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .sm-lang-toggle {
    display: flex;
    gap: 2px;
    background: var(--line);
    border-radius: 8px;
    padding: 2px;
  }
  .sm-lang-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.4em 0.5em;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1;
    text-decoration: none;
    text-align: center;
    white-space: nowrap;
    transition: background var(--dur-1) var(--ease), color var(--dur-1) var(--ease);
  }
  .sm-lang-btn[aria-checked='true'] {
    background: var(--paper);
    color: var(--ink);
  }
  .sm-lang-btn:hover,
  .sm-lang-btn:focus-visible {
    color: var(--accent-ink);
  }

  /* ---- No-JS fallback ---- */
  .sm-fallback {
    position: absolute;
    top: 0;
    right: 0;
    pointer-events: auto;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    padding: var(--space-xs) var(--edge);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
  }
  .sm-fallback a { color: var(--ink); }

  @media (max-width: 640px) {
    .sm-panel,
    .sm-ghost {
      width: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sm-toggle-textInner,
    .sm-icon-line {
      transition-duration: 0.001s;
      transition-delay: 0s;
    }
  }
</style>

<script>
  // Nav is no longer transition:persist'd — each navigation replaces it with
  // a freshly server-rendered instance (so locale text/hrefs are always
  // correct). ClientRouter dedupes this identical script chunk across pages
  // the same way it does for Lightbox.astro, so it never re-runs on its own;
  // astro:page-load fires on every navigation regardless, so init from
  // there. Each run's listeners are torn down via the abort signal before the
  // next run binds fresh ones to the new DOM.
  import gsap from 'gsap';
  import { buildPixelPlan, buildClipKeyframes, resolveTileSize, prefersReducedMotion, runAccentTrail, PIXEL_EASE } from '../../scripts/pixel-transition';

  const MENU_DESKTOP_TILE = 20;
  const MENU_MOBILE_TILE = 14;
  const MENU_OPEN_MS = 600;
  const MENU_CLOSE_MS = 500;
  const MENU_BUCKETS = 26;
  // How far ahead (open) / behind (close) the opposite-theme ghost layer
  // runs relative to the real panel — the visible window where the ghost's
  // color shows through before the real panel catches up to the same shape.
  const GHOST_LEAD_MS = 140;

  // Menu text itself never animates — only the panel surface materializes/
  // consumes through the pixel mask. Origin is pinned to the panel's own
  // right edge (== the viewport's right edge, since the panel is flush
  // right) rather than the trigger button — the button only calls setOpen,
  // it never supplies a coordinate. Rapid clicks are ignored while a reveal
  // is in flight (same guard the theme toggle uses) rather than interrupted
  // mid-shape, which would jump.
  function initNav(signal: AbortSignal) {
    const root = document.querySelector<HTMLElement>('[data-nav]');
    if (!root) return;
    const btn = root.querySelector<HTMLButtonElement>('.sm-toggle');
    if (!btn) return;
    const panel = root.querySelector<HTMLElement>('#staggered-menu-panel');
    if (!panel) return;
    const ghost = root.querySelector<HTMLElement>('[data-nav-ghost]');
    if (!ghost) return;
    const pixels = Array.from(panel.querySelectorAll<HTMLElement>('[data-sm-pixel]'));

    // Idle-bar entrance: logo, theme toggle, menu trigger swipe down from
    // above the viewport once on mount — not the staggered panel (that's
    // setOpen's own pixel-cascade reveal below, untouched). Each fresh Nav
    // instance replays this, same as Hero's own load cascade in animate.ts.
    //
    // Lands last, together with the keyboard: on pages with a Hero, both
    // wait on the same 'hero-stage-reveal' event (dispatched near the end
    // of animate.ts's GSAP timeline; Hero.astro's own script plays the
    // keyboard's pixel reveal off the same event). Pages without a Hero
    // (projects, project detail, 404) never get that event, so the bar
    // plays immediately there instead of waiting forever.
    if (!prefersReducedMotion()) {
      // Off-screen the instant this runs, synchronously — gsap.from() only
      // applies its hidden state lazily, at the moment it's actually called,
      // which here could be seconds after page-load (waiting on the event
      // below). gsap.set() + a later gsap.to() is what makes it hidden from
      // the very first frame instead of flashing visible until the reveal.
      gsap.set('.sm-logo, .tt-btn, .sm-toggle', { y: -40, opacity: 0 });

      const playBarEntrance = () => {
        gsap.to('.sm-logo, .tt-btn, .sm-toggle', {
          y: 0,
          opacity: 1,
          duration: 0.85,
          ease: 'expo.out',
          stagger: 0.08,
        });
      };
      if (document.querySelector('[data-hero]')) {
        document.addEventListener('hero-stage-reveal', playBarEntrance, { once: true });
      } else {
        playBarEntrance();
      }
    }

    let open = false;
    let animating = false;

    const setOpen = (v: boolean) => {
      if (animating || open === v) return;
      open = v;
      root.toggleAttribute('data-open', v);
      btn.setAttribute('aria-expanded', String(v));
      btn.setAttribute('aria-label', v ? (btn.dataset.closeLabel ?? 'Close menu') : (btn.dataset.openLabel ?? 'Open menu'));

      if (prefersReducedMotion()) {
        panel.style.clipPath = v ? 'inset(0 0 0 0)' : 'inset(0 0 0 100%)';
        panel.style.visibility = v ? 'visible' : 'hidden';
        panel.setAttribute('aria-hidden', String(!v));
        return;
      }

      if (v) {
        panel.style.visibility = 'visible';
        panel.setAttribute('aria-hidden', 'false');
      }

      // Reads before writes: measure once, synchronously, before the
      // animation starts — nothing in the reveal itself touches layout.
      const panelRect = panel.getBoundingClientRect();
      // Origin sits far outside the panel, straight out from its vertical
      // center on the right — not just AT the right edge — so the reveal
      // reads as a near-planar right-to-left wavefront (dominant horizontal
      // direction) instead of a circular wave bowing out from a point.
      // Distance-from-origin still does all the work; this is a call-site
      // parameter, not a change to the shared pixel engine.
      const origin = {
        x: panelRect.width + panelRect.height * 4,
        y: panelRect.height / 2,
      };
      const tileSize = resolveTileSize(MENU_DESKTOP_TILE, MENU_MOBILE_TILE);
      const plan = buildPixelPlan({
        width: panelRect.width,
        height: panelRect.height,
        origin,
        tileSize,
        direction: { x: -1, y: 0 },
      });
      const keyframes = buildClipKeyframes(plan, { buckets: MENU_BUCKETS, reverse: !v });
      const totalMs = v ? MENU_OPEN_MS : MENU_CLOSE_MS;
      const segmentMs = totalMs - GHOST_LEAD_MS;

      // Opening: the opposite-theme ghost sweeps first, the real panel
      // follows GHOST_LEAD_MS behind — so the leading edge briefly shows
      // the ghost's color before the real panel's own reveal reaches it.
      // Closing: the real panel retreats first, the ghost follows behind —
      // so the gap the panel leaves behind is briefly filled by the ghost's
      // color until the ghost itself finishes collapsing toward the origin.
      const leadEl = v ? ghost : panel;
      const lagEl = v ? panel : ghost;

      animating = true;
      // The ghost needs to be paintable for the whole transition on both
      // open (it leads, starting at 0ms) and close (it lags, starting at
      // GHOST_LEAD_MS but its fill: 'both' pre-delay frame — full coverage
      // — must actually render during that delay).
      ghost.style.visibility = 'visible';
      const leadAnim = leadEl.animate(keyframes, { duration: segmentMs, easing: PIXEL_EASE, fill: 'forwards' });
      const lagAnim = lagEl.animate(keyframes, {
        duration: segmentMs,
        delay: GHOST_LEAD_MS,
        easing: PIXEL_EASE,
        fill: 'both',
      });
      // Always sample the un-delayed animation: runAccentTrail's rAF loop
      // bails out the first time getComputedTiming().progress is null,
      // which is permanent for an animation still in its `delay` phase.
      if (pixels.length) runAccentTrail(leadAnim, plan, pixels, { samples: 5, gsap });

      Promise.all([leadAnim.finished, lagAnim.finished])
        .then(() => {
          panel.style.clipPath = v ? 'inset(0 0 0 0)' : 'inset(0 0 0 100%)';
          ghost.style.clipPath = 'inset(0 0 0 100%)';
          ghost.style.visibility = 'hidden';
          if (!v) {
            panel.style.visibility = 'hidden';
            panel.setAttribute('aria-hidden', 'true');
          }
          leadAnim.cancel();
          lagAnim.cancel();
          gsap.set(pixels, { opacity: 0 });
        })
        .catch(() => undefined)
        .finally(() => {
          animating = false;
        });
    };

    btn.addEventListener('click', () => setOpen(!open), { signal });
    root.querySelectorAll('.sm-panel-item').forEach((a) =>
      a.addEventListener('click', () => setOpen(false), { signal }),
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && open) setOpen(false);
    }, { signal });
    document.addEventListener('click', (e) => {
      if (open && e.target instanceof Node && !root.contains(e.target)) setOpen(false);
    }, { signal });

    // Fade the bar background in only after the first viewport is scrolled past.
    const onScroll = () => root.toggleAttribute('data-scrolled', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true, signal });
  }

  // --- Language switcher logic ---
  // Recomputes hrefs/aria-checked from the live pathname rather than
  // trusting server-rendered state, since a click can land here before the
  // next navigation's fresh Nav has fully replaced this one.
  function initLang(signal: AbortSignal) {
    const btns = document.querySelectorAll<HTMLAnchorElement>('.sm-lang-btn');
    if (!btns.length) return;

    const sync = () => {
      const path = location.pathname;
      const isId = /^\/id(\/|$)/.test(path);
      const bare = path.replace(/^\/id(?=\/|$)/, '') || '/';
      const enHref = bare + location.search + location.hash;
      const idHref = (bare === '/' ? '/id/' : '/id' + bare) + location.search + location.hash;
      btns.forEach((a) => {
        const val = a.dataset.langVal;
        a.setAttribute('href', val === 'id' ? idHref : enHref);
        a.setAttribute('aria-checked', String((val === 'id') === isId));
      });
    };

    btns.forEach((a) => {
      a.addEventListener('click', () => {
        const val = a.dataset.langVal;
        if (val) localStorage.setItem('lang', val);
      }, { signal });
    });

    sync();
  }

  let cleanup: AbortController | null = null;
  function initAll() {
    cleanup?.abort();
    cleanup = new AbortController();
    const { signal } = cleanup;
    initNav(signal);
    initLang(signal);
  }

  document.addEventListener('astro:page-load', initAll);
</script>
