---
// Staggered slide-in menu — an Astro adaptation of the React Bits StaggeredMenu
// (https://reactbits.dev/components/staggered-menu). Re-skinned to the hallmark
// palette/type. Open state is a single [data-open] attribute; the stagger is
// pure CSS (per-item transition-delay), so it works with no framework, degrades
// without JS, and respects reduced-motion.
import { cv } from '../../data/cv.data';
const { basics } = cv;

const items = [
  { label: 'About', link: '/#about-title', ariaLabel: 'Jump to about' },
  { label: 'Stack', link: '/#skills-title', ariaLabel: 'Jump to stack' },
  { label: 'Work', link: '/#projects-title', ariaLabel: 'Jump to selected work' },
  { label: 'Experience', link: '/#experience-title', ariaLabel: 'Jump to experience' },
  { label: 'Volunteer', link: '/#volunteer-title', ariaLabel: 'Jump to volunteer' },
  { label: 'Certifications', link: '/#certifications-title', ariaLabel: 'Jump to certifications' },
  { label: 'Languages', link: '/#languages-title', ariaLabel: 'Jump to languages' },
  { label: 'Contact', link: '/#contact-title', ariaLabel: 'Jump to contact' },
  {
    label: 'Visitors',
    link: 'https://cloud.umami.is/share/132aI2gdoyz9vhLj',
    ariaLabel: 'View site visitor analytics (opens in a new tab)',
    external: true,
  },
];
const socials = basics.profiles.map((p) => ({ label: p.network, link: p.url }));
---

<div class="nav" data-nav transition:persist transition:name="site-nav">
  <div class="sm-bar" aria-hidden="true"></div>

  <div class="sm-prelayers" aria-hidden="true">
    <div class="sm-prelayer sm-prelayer--1"></div>
    <div class="sm-prelayer sm-prelayer--2"></div>
  </div>

  <header class="sm-header">
    <a class="sm-logo" href="/#main">
      <span aria-hidden="true">dendi'</span>
      <span class="visually-hidden">{basics.name} — home</span>
    </a>

    <button
      class="sm-toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="staggered-menu-panel"
    >
      <span class="sm-toggle-textWrap" aria-hidden="true">
        <span class="sm-toggle-textInner">
          <span class="sm-toggle-line">Menu</span>
          <span class="sm-toggle-line">Close</span>
        </span>
      </span>
      <span class="sm-icon" aria-hidden="true">
        <span class="sm-icon-line"></span>
        <span class="sm-icon-line sm-icon-line-v"></span>
      </span>
    </button>
  </header>

  <aside id="staggered-menu-panel" class="sm-panel" aria-label="Menu" aria-hidden="true">
    <div class="sm-panel-inner">
      <ul class="sm-panel-list" data-numbering role="list">
        {items.map((it, i) => (
          <li class="sm-panel-itemWrap" style={`--i:${i}`}>
            <a
              class="sm-panel-item"
              href={it.link}
              aria-label={it.ariaLabel}
              target={it.external ? '_blank' : undefined}
              rel={it.external ? 'noopener noreferrer' : undefined}
            >
              <span class="sm-panel-itemLabel">{it.label}</span>
            </a>
          </li>
        ))}
      </ul>

      {socials.length > 0 && (
        <div class="sm-socials" aria-label="Social links">
          <h3 class="sm-socials-title">Elsewhere</h3>
          <ul class="sm-socials-list" role="list">
            {socials.map((s, i) => (
              <li class="sm-socials-item" style={`--i:${i}`}>
                <a class="sm-socials-link" href={s.link} target="_blank" rel="noopener noreferrer">{s.label}</a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="sm-theme">
        <h3 class="sm-theme-title">Theme</h3>
        <div class="sm-theme-toggle" role="radiogroup" aria-label="Colour scheme">
          <button class="sm-theme-btn" data-theme-val="light" role="radio" aria-checked="false" type="button" title="Light">
            <svg class="sm-theme-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="5"/>
              <line x1="12" y1="1" x2="12" y2="3"/>
              <line x1="12" y1="21" x2="12" y2="23"/>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
              <line x1="1" y1="12" x2="3" y2="12"/>
              <line x1="21" y1="12" x2="23" y2="12"/>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
            </svg>
            <span>Light</span>
          </button>
          <button class="sm-theme-btn" data-theme-val="dark" role="radio" aria-checked="false" type="button" title="Dark">
            <svg class="sm-theme-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
            <span>Dark</span>
          </button>
          <button class="sm-theme-btn" data-theme-val="auto" role="radio" aria-checked="false" type="button" title="Auto (follow device)">
            <svg class="sm-theme-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
              <line x1="8" y1="21" x2="16" y2="21"/>
              <line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
            <span>Auto</span>
          </button>
        </div>
      </div>
    </div>
  </aside>

  <noscript>
    <ul class="sm-fallback">
      {items.map((it) => (
        <li>
          <a href={it.link} target={it.external ? '_blank' : undefined} rel={it.external ? 'noopener noreferrer' : undefined}>
            {it.label}
          </a>
        </li>
      ))}
    </ul>
  </noscript>
</div>

<style>
  /* Fixed overlay; transparent + click-through except its interactive children */
  .nav {
    position: fixed;
    inset: 0;
    z-index: 40;
    pointer-events: none;
  }

  /* ---- Staggered colour underlays ---- */
  .sm-prelayers {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: clamp(280px, 42vw, 460px);
    pointer-events: none;
    z-index: 20;
  }
  .sm-prelayer {
    position: absolute;
    inset: 0;
    transform: translateX(100%);
    transition: transform var(--dur-2) var(--ease);
  }
  .sm-prelayer--1 { background: var(--accent); }
  .sm-prelayer--2 { background: var(--ink); }
  .nav[data-open] .sm-prelayer { transform: translateX(0); }
  .nav[data-open] .sm-prelayer--1 { transition-delay: 0s; }
  .nav[data-open] .sm-prelayer--2 { transition-delay: 0.07s; }

  /* ---- Top bar background (its own layer, below the panel) ---- */
  .sm-bar {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--nav-h);
    pointer-events: none;
    z-index: 15;
    /* Transparent over the first viewport; a paper bar fades in once scrolled */
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background var(--dur-1) var(--ease), border-color var(--dur-1) var(--ease);
  }
  .nav[data-scrolled] .sm-bar,
  .nav[data-open] .sm-bar {
    background: color-mix(in oklab, var(--paper) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .nav[data-scrolled] .sm-bar {
    border-bottom-color: var(--line);
  }

  /* ---- Top bar controls (above the panel so the toggle always closes it) ---- */
  .sm-header {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    min-height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding: var(--space-s) var(--edge);
    pointer-events: none;
    z-index: 45;
  }
  .sm-header > * {
    pointer-events: auto;
  }
  .sm-logo {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-variation-settings: 'opsz' 40, 'wght' 620, var(--wonk-off);
    color: var(--accent);
    letter-spacing: -0.01em;
    transition: font-variation-settings var(--dur-2) var(--ease);
  }
  .sm-logo:hover {
    font-variation-settings: 'opsz' 40, 'wght' 780, 'SOFT' 40, 'WONK' 1;
  }

  .sm-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    background: transparent;
    border: 0;
    cursor: pointer;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--step-0);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
    overflow: visible;
  }
  .sm-toggle-textWrap {
    position: relative;
    display: inline-block;
    height: 1em;
    overflow: hidden;
    white-space: nowrap;
  }
  .sm-toggle-textInner {
    display: flex;
    flex-direction: column;
    line-height: 1;
    transition: transform var(--dur-1) var(--ease);
  }
  .sm-toggle-line {
    display: block;
    height: 1em;
    line-height: 1;
  }
  .nav[data-open] .sm-toggle-textInner {
    transform: translateY(-50%);
  }

  .sm-icon {
    position: relative;
    width: 18px;
    height: 18px;
    flex: 0 0 18px;
    display: inline-flex;
  }
  .sm-icon-line {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 100%;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transform: translate(-50%, -50%) rotate(0deg);
    transition: transform var(--dur-1) var(--ease);
  }
  .sm-icon-line-v {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  .nav[data-open] .sm-icon-line { transform: translate(-50%, -50%) rotate(45deg); }
  .nav[data-open] .sm-icon-line-v { transform: translate(-50%, -50%) rotate(135deg); }

  /* ---- Panel ---- */
  .sm-panel {
    position: absolute;
    top: 0;
    right: 0;
    width: clamp(280px, 42vw, 460px);
    height: 100%;
    background: var(--paper);
    display: flex;
    flex-direction: column;
    padding: var(--space-xl) var(--space-m) var(--space-l);
    overflow-y: auto;
    transform: translateX(100%);
    visibility: hidden;
    z-index: 30;
    pointer-events: auto;
    border-left: 1px solid var(--line-strong);
    /* Size the menu items relative to the panel width, not the viewport */
    container-type: inline-size;
    transition: transform var(--dur-2) var(--ease), visibility 0s linear var(--dur-2);
  }
  .nav[data-open] .sm-panel {
    transform: translateX(0);
    visibility: visible;
    transition: transform var(--dur-2) var(--ease), visibility 0s;
    transition-delay: 0.12s;
  }
  .sm-panel-inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
  }
  .sm-panel-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }
  .sm-panel-itemWrap {
    position: relative;
    overflow: hidden;
    line-height: 1;
    padding-right: 1.8em; /* reserved column for the running number */
  }
  .sm-panel-item {
    position: relative;
    display: inline-block;
    max-width: 100%;
    color: var(--ink);
    font-family: var(--font-display);
    /* cqi = share of the panel width, so long labels never overflow the panel */
    font-size: clamp(1.45rem, 10cqi, 2.6rem);
    font-variation-settings: 'opsz' 60, 'wght' 500, var(--wonk-off);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: color var(--dur-1) var(--ease), font-variation-settings var(--dur-2) var(--ease);
  }
  .sm-panel-itemLabel {
    display: inline-block;
    transform: translateY(130%) rotate(6deg);
    transform-origin: 0% 100%;
    transition: transform var(--dur-2) var(--ease);
  }
  .nav[data-open] .sm-panel-itemLabel {
    transform: translateY(0) rotate(0deg);
    transition-delay: calc(0.2s + var(--i) * 0.05s);
  }
  .sm-panel-item:hover,
  .sm-panel-item:focus-visible {
    color: var(--accent-ink);
    font-variation-settings: 'opsz' 72, 'wght' 620, var(--wonk-on);
  }
  .sm-panel-list[data-numbering] {
    counter-reset: smItem;
  }
  /* Number sits in the wrap's reserved column (panel edge), not the item's own
     right edge — so it stays inside the panel regardless of label length. */
  .sm-panel-list[data-numbering] .sm-panel-itemWrap {
    counter-increment: smItem;
  }
  .sm-panel-list[data-numbering] .sm-panel-itemWrap::after {
    content: counter(smItem, decimal-leading-zero);
    position: absolute;
    top: 0.4em;
    right: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--accent);
    pointer-events: none;
    user-select: none;
    opacity: 0;
    transition: opacity var(--dur-1) var(--ease);
  }
  .nav[data-open] .sm-panel-itemWrap::after {
    opacity: 1;
    transition-delay: calc(0.35s + var(--i) * 0.05s);
  }

  /* ---- Socials ---- */
  .sm-socials {
    margin-top: auto;
    padding-top: var(--space-m);
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }
  .sm-socials-title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    opacity: 0;
    transition: opacity var(--dur-1) var(--ease);
  }
  .nav[data-open] .sm-socials-title {
    opacity: 1;
    transition-delay: 0.4s;
  }
  .sm-socials-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
  }
  .sm-socials-item {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity var(--dur-1) var(--ease), transform var(--dur-1) var(--ease);
  }
  .nav[data-open] .sm-socials-item {
    opacity: 1;
    transform: translateY(0);
    transition-delay: calc(0.45s + var(--i) * 0.06s);
  }
  .sm-socials-link {
    font-family: var(--font-mono);
    font-size: var(--step-0);
    color: var(--ink);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid var(--line);
    transition: color var(--dur-1) var(--ease), border-color var(--dur-1) var(--ease);
  }
  .sm-socials-link:hover,
  .sm-socials-link:focus-visible {
    color: var(--accent-ink);
    border-color: var(--accent);
  }

  /* ---- Theme toggle ---- */
  .sm-theme {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }
  .sm-theme-title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    opacity: 0;
    transition: opacity var(--dur-1) var(--ease);
  }
  .nav[data-open] .sm-theme-title {
    opacity: 1;
    transition-delay: 0.4s;
  }
  .sm-theme-toggle {
    display: flex;
    gap: 2px;
    background: var(--line);
    border-radius: 8px;
    padding: 2px;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity var(--dur-1) var(--ease), transform var(--dur-1) var(--ease);
  }
  .nav[data-open] .sm-theme-toggle {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.45s;
  }
  .sm-theme-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35em;
    padding: 0.4em 0.5em;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    line-height: 1;
    cursor: pointer;
    white-space: nowrap;
    transition: background var(--dur-1) var(--ease), color var(--dur-1) var(--ease);
  }
  .sm-theme-btn[aria-checked='true'] {
    background: var(--paper);
    color: var(--ink);
  }
  .sm-theme-btn:hover {
    color: var(--ink);
  }
  .sm-theme-icon {
    width: 1em;
    height: 1em;
    flex: 0 0 1em;
  }

  /* ---- No-JS fallback ---- */
  .sm-fallback {
    position: absolute;
    top: 0;
    right: 0;
    pointer-events: auto;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    padding: var(--space-xs) var(--edge);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
  }
  .sm-fallback a { color: var(--ink); }

  @media (max-width: 640px) {
    .sm-prelayers,
    .sm-panel {
      width: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sm-prelayer,
    .sm-panel,
    .sm-panel-itemLabel,
    .sm-panel-itemWrap::after,
    .sm-socials-title,
    .sm-socials-item,
    .sm-theme-title,
    .sm-theme-toggle,
    .sm-toggle-textInner,
    .sm-icon-line {
      transition-duration: 0.001s;
      transition-delay: 0s;
    }
  }
</style>

<script>
  // Minimal, robust: flip a single [data-open] attribute; CSS does the rest.
  function initNav() {
    const root = document.querySelector<HTMLElement>('[data-nav]');
    if (!root) return;
    const btn = root.querySelector<HTMLButtonElement>('.sm-toggle');
    if (!btn) return;
    const panel = root.querySelector<HTMLElement>('#staggered-menu-panel');

    let open = false;
    const setOpen = (v: boolean) => {
      open = v;
      root.toggleAttribute('data-open', v);
      btn.setAttribute('aria-expanded', String(v));
      btn.setAttribute('aria-label', v ? 'Close menu' : 'Open menu');
      panel?.setAttribute('aria-hidden', String(!v));
    };

    btn.addEventListener('click', () => setOpen(!open));
    root.querySelectorAll('.sm-panel-item').forEach((a) =>
      a.addEventListener('click', () => setOpen(false)),
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && open) setOpen(false);
    });
    document.addEventListener('click', (e) => {
      if (open && e.target instanceof Node && !root.contains(e.target)) setOpen(false);
    });

    // Fade the bar background in only after the first viewport is scrolled past.
    const onScroll = () => root.toggleAttribute('data-scrolled', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  // --- Theme toggle logic ---
  function initTheme() {
    const root = document.documentElement;
    const btns = document.querySelectorAll<HTMLButtonElement>('.sm-theme-btn');
    const meta = document.getElementById('theme-color-meta');

    if (!btns.length) return;

    const sync = () => {
      const stored = localStorage.getItem('theme') || 'auto';
      btns.forEach((b) => {
        const val = b.getAttribute('data-theme-val');
        b.setAttribute('aria-checked', String(val === stored));
      });
    };

    // Resolve current rendered theme for the meta update
    const resolveTheme = (): 'light' | 'dark' => {
      const stored = localStorage.getItem('theme') || 'auto';
      if (stored === 'light') return 'light';
      if (stored === 'dark') return 'dark';
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    };

    const apply = (val: string) => {
      if (val === 'light') {
        root.setAttribute('data-theme', 'light');
        root.style.colorScheme = 'light';
        localStorage.setItem('theme', 'light');
      } else if (val === 'dark') {
        root.setAttribute('data-theme', 'dark');
        root.style.colorScheme = 'dark';
        localStorage.setItem('theme', 'dark');
      } else {
        // auto
        localStorage.setItem('theme', 'auto');
        const mq = window.matchMedia('(prefers-color-scheme: dark)');
        root.setAttribute('data-theme', mq.matches ? 'dark' : 'light');
        root.style.colorScheme = 'light dark';
      }
      sync();
      if (meta) {
        meta.setAttribute(
          'content',
          resolveTheme() === 'dark' ? '#1a1814' : '#f0ece1'
        );
      }
    };

    btns.forEach((b) => {
      b.addEventListener('click', () => {
        const val = b.getAttribute('data-theme-val');
        if (val) apply(val);
      });
    });

    // Listen for device colour-scheme changes when in auto mode
    const mql = window.matchMedia('(prefers-color-scheme: dark)');
    mql.addEventListener('change', () => {
      if (localStorage.getItem('theme') === 'auto') {
        root.setAttribute('data-theme', mql.matches ? 'dark' : 'light');
        if (meta) {
          meta.setAttribute('content', mql.matches ? '#1a1814' : '#f0ece1');
        }
      }
    });

    sync();
  }

  initNav();
  initTheme();
</script>
