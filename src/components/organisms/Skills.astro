---
import SectionHeader from '../molecules/SectionHeader.astro';
import TagList from '../atoms/TagList.astro';
import { getCV, t, resolveLocale } from '../../i18n';
const locale = resolveLocale(Astro.currentLocale);
const { skills } = getCV(locale);
const ui = t(locale);
---

<section class="skills shell" aria-labelledby="skills-title">
  <SectionHeader index="02" id="skills-title" title={ui.sections.skills.title} kicker={ui.sections.skills.kicker} axis="WGHT 440 · OPSZ 50" />

  <div class="skills__index">
    {skills.map((group, i) => (
      <div class="skills__row">
        <div class="skills__row-label">
          <span class="skills__row-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="skills__row-name">{group.name}</h3>
        </div>
        <div class="skills__row-tags">
          <TagList items={group.keywords} label={`${group.name} — stack`} />
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .skills__index {
    border-top: 1px solid var(--line);
  }
  .skills__row {
    display: grid;
    grid-template-columns: minmax(7rem, 12rem) 1fr;
    align-items: start;
    gap: var(--space-s) var(--space-m);
    padding: var(--space-s) 0;
    border-bottom: 1px solid var(--line);
  }
  .skills__row-label {
    display: flex;
    align-items: baseline;
    gap: var(--space-2xs);
    padding-top: 0.35em;
  }
  .skills__row-num {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
  }
  .skills__row-name {
    font-family: var(--font-mono);
    font-size: var(--step-0);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--ink);
    line-height: 1.2;
  }
  @media (max-width: 720px) {
    .skills__row {
      grid-template-columns: 1fr;
      gap: var(--space-xs);
    }
    .skills__row-label {
      padding-top: 0;
    }
  }
</style>
