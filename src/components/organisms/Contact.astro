---
import SectionHeader from '../molecules/SectionHeader.astro';
import SocialLink from '../atoms/SocialLink.astro';
import { getCV, t, resolveLocale } from '../../i18n';
import { homeRegion } from '../../data/format';
const locale = resolveLocale(Astro.currentLocale);
const { basics } = getCV(locale);
const ui = t(locale);
const year = new Date().getFullYear();
const place = homeRegion(basics.location, locale);

const FREELANCE_NETWORKS = new Set(['Upwork', 'Fiverr']);
const social = basics.profiles.filter((p) => !FREELANCE_NETWORKS.has(p.network));
const freelance = basics.profiles.filter((p) => FREELANCE_NETWORKS.has(p.network));
---

<footer class="contact shell" id="contact" aria-labelledby="contact-title">
  <SectionHeader index="08" id="contact-title" title={ui.sections.contact.title} kicker={ui.sections.contact.kicker} axis="WGHT 500 · OPSZ 90" />
  <div class="contact__cols">
    <div class="contact__col">
      <p class="label">{ui.contact.direct}</p>
      <SocialLink href={`mailto:${basics.email}`} network={"Gmail"} handle={basics.email} />
    </div>

    <div class="contact__col">
      <p class="label">{ui.contact.social}</p>
      {social.map((p) => (
        <SocialLink href={p.url} network={p.network} handle={`@${p.username}`} />
      ))}
    </div>

    <div class="contact__col">
      <p class="label">{ui.contact.freelance}</p>
      {freelance.map((p) => (
        <SocialLink href={p.url} network={p.network} handle={`@${p.username}`} />
      ))}
    </div>

    <div class="contact__col contact__col--avail">
      <p class="label">{ui.contact.availability}</p>
      <ul class="contact__avail">
        <li>
          <span class="contact__avail-key">{ui.contact.openTo}</span>
          <span class="contact__avail-val">{ui.contact.openToValue(basics.location.region)}</span>
        </li>
        <li>
          <span class="contact__avail-key">{ui.contact.basedIn}</span>
          <span class="contact__avail-val">{ui.contact.basedInValue(place)}</span>
        </li>
        <li>
          <span class="contact__avail-key">{ui.contact.replyTime}</span>
          <span class="contact__avail-val">{ui.contact.replyTimeValue}</span>
        </li>
      </ul>
    </div>

    <div class="contact__trail" aria-hidden="true"></div>
  </div>


  <div class="contact__base">
    <span>© {year} {basics.name}</span>
    <span class="contact__loc">Build with <a target="_blank" class="contact__loc__link" href="https://astro.build/">Astro 7</a></span>
  </div>
</footer>

<style>
  .contact {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-l);
  }

  .contact__cols {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-l) var(--space-m);
    padding-bottom: var(--space-xl);
  }
  .contact__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    align-items: flex-start;
  }
  .contact__avail {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }
  .contact__avail li {
    display: flex;
    flex-direction: column;
    gap: 0.15em;
  }
  .contact__avail-key {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--accent-ink);
  }
  .contact__avail-val {
    font-size: var(--step-0);
    color: var(--ink);
  }

  .contact__trail {
    position: absolute;
    background-image: url('/static/sections/footer/cable_trail_light.png');
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    filter: grayscale(100%);
    opacity: 0.1;
  }
  :root[data-theme='dark'] .contact__trail {
    background-image: url('/static/sections/footer/cable_trail_dark.png');
  }

  /*hidden contact__trail in mobile*/
  @media (max-width: 520px) {
    .contact__trail {
      display: none;
    }
  }

  .contact__base {
    padding-top: var(--space-s);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-m);
    justify-content: space-between;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--faint);
  }

  .contact__loc {
    display: flex;
    gap: var(--space-xs);
    align-items: center;
  }

  .contact__loc__link {
    color: var(--faint);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    transition: color var(--dur-1) var(--ease);
  }

  .contact__loc__link:hover {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  @media (max-width: 920px) {
    .contact__cols {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 520px) {
    .contact__cols {
      grid-template-columns: 1fr;
      padding-bottom: var(--space-m);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .contact__email, .contact__email-text { transition: color var(--dur-1) var(--ease); }
    .contact__email:hover { font-variation-settings: 'opsz' 90, 'wght' 460, var(--wonk-off); }
  }
</style>
