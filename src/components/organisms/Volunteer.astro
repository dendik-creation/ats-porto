---
import SectionHeader from '../molecules/SectionHeader.astro';
import { cv } from '../../data/cv.data';
import { rangeLabel } from '../../data/format';
const { volunteer } = cv;
---

<section class="vol shell" aria-labelledby="volunteer-title">
  <SectionHeader index="05" id="volunteer-title" title="Volunteer" kicker="Beyond the job" axis="WGHT 520 · OPSZ 30" />

  <div class="vol__list">
    {volunteer.map((v) => {
      const range = v.startDate && v.endDate ? rangeLabel(v.startDate, v.endDate) : '';
      const isCurrent = v.endDate === 'Present';
      return (
        <article class="vol__item">
          <div class="vol__meta">
            {range && (
              <p class="vol__range label">
                {range}
                {isCurrent && <span class="vol__now" aria-label="current">●</span>}
              </p>
            )}
            <p class="vol__loc">{v.location}</p>
          </div>
          <div class="vol__body">
            <h3 class="vol__role">{v.organization}</h3>
            <p class="vol__position">{v.position}</p>
            {v.summary && <p class="vol__summary">{v.summary}</p>}
            <ul class="vol__highlights">
              {v.highlights.map((h) => <li>{h}</li>)}
            </ul>
          </div>
        </article>
      );
    })}
  </div>
</section>

<style>
  /* Same layout as Experience — sticky meta column beside the body */
  .vol__list {
    border-bottom: 1px solid var(--line);
  }
  .vol__item {
    display: grid;
    grid-template-columns: minmax(9rem, 15rem) 1fr;
    gap: var(--space-s) var(--space-m);
    padding: var(--space-m) 0;
    border-top: 1px solid var(--line);
  }
  .vol__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    position: sticky;
    top: var(--space-s);
    align-self: start;
    height: fit-content;
  }
  .vol__range {
    display: flex;
    align-items: center;
    gap: 0.5em;
    color: var(--ink);
  }
  .vol__now {
    color: var(--accent);
    font-size: 0.7em;
    animation: pulse 2.4s var(--ease) infinite;
  }
  .vol__loc {
    color: var(--faint);
    font-size: var(--step--1);
  }
  .vol__role {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-variation-settings: 'opsz' 30, 'wght' 520, var(--wonk-off);
    line-height: 1.1;
  }
  .vol__position {
    font-family: var(--font-mono);
    font-size: var(--step-0);
    color: var(--accent-ink);
    margin-top: 0.2em;
    margin-bottom: var(--space-xs);
  }
  .vol__summary {
    color: var(--muted);
    max-width: var(--measure);
    margin-bottom: var(--space-s);
  }
  .vol__highlights {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    max-width: var(--measure);
  }
  .vol__highlights li {
    position: relative;
    padding-left: 1.4em;
  }
  .vol__highlights li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-family: var(--font-mono);
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }
  @media (prefers-reduced-motion: reduce) {
    .vol__now { animation: none; }
  }
  @media (max-width: 640px) {
    .vol__item {
      grid-template-columns: 1fr;
      gap: var(--space-s);
    }
    .vol__meta {
      position: static;
      flex-direction: row;
      justify-content: space-between;
    }
  }
</style>
