---
// Page-load / page-change curtain — the fullscreen tier of the Pixel Motion
// System (see src/scripts/pixel-transition.ts). Persists across ClientRouter
// swaps so the covering/uncovering animation is continuous rather than being
// torn down mid-transition.
//
// Covers the viewport by default (see .pt-layer below) so there's no gap
// between first paint and JS taking over. Real navigations reveal through
// the --ink pixel cascade below. The very first document load has no
// navigation behind it, so page-transition.ts just drops this cover
// instantly instead — InitialPixelCurtain.astro owns that reveal now.
---

<div class="pt-veil" data-pt aria-hidden="true" transition:persist transition:name="page-veil">
  <div class="pt-layer"></div>
  {Array.from({ length: 8 }).map((_, i) => (
    <span class="pt-pixel opacity-0" data-pt-pixel={i} aria-hidden="true"></span>
  ))}
</div>

<style>
  .pt-veil {
    position: fixed;
    inset: 0;
    z-index: 90;
    pointer-events: none;
  }
  .pt-veil[data-active] {
    pointer-events: auto;
  }
  .pt-layer {
    position: absolute;
    inset: 0;
    background: var(--ink);
    clip-path: inset(0 0 0 0); /* covering — the pre-JS, pre-load default */
  }
  /* Boundary accent trail for the fullscreen cascade — same reused-node
     technique as the theme toggle's .tt-pixel. */
  .pt-pixel {
    position: absolute;
    width: 24px;
    height: 24px;
    background: var(--accent);
    border-radius: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .pt-veil {
      display: none;
    }
  }
</style>

<noscript>
  <style>
    .pt-veil {
      display: none;
    }
  </style>
</noscript>
