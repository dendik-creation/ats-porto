---
import SectionHeader from '../molecules/SectionHeader.astro';
import SectionIllustration from '../molecules/SectionIllustration.astro';
import TagList from '../atoms/TagList.astro';
import { getCV, t, resolveLocale } from '../../i18n';
import { rangeLabel } from '../../data/format';
const locale = resolveLocale(Astro.currentLocale);
const { work } = getCV(locale);
const ui = t(locale);
---

<section class="experience shell" aria-labelledby="experience-title">
  <div class="section-heading-stage">
    <SectionHeader index="04" id="experience-title" title={ui.sections.experience.title} kicker={ui.sections.experience.kicker} axis="WGHT 460 · OPSZ 60" />
    <SectionIllustration
      src="/static/arc/experience-blueprint-workbench.webp"
      width={1774}
      height={887}
      duration={850}
      tileMin={16}
      tileMax={64}
      artWidth="clamp(480px, 52vw, 820px)"
      artRight="-5%"
      artOpacity="0.28"
      mobileWidth="145vw"
      mobileRight="-55%"
      mobileOpacity="0.08"
      fadeEdge="left"
    />
  </div>

  <div class="experience__content">
    <div class="exp__list">
      {work.map((w) => {
        const isCurrent = w.endDate === 'Present';
        return (
          <article class="exp__item">
            <div class="exp__meta">
              <p class="exp__range label">
                {rangeLabel(w.startDate, w.endDate, locale)}
                {isCurrent && <span class="exp__now" aria-label={ui.experience.currentRoleAria}>●</span>}
              </p>
              <p class="exp__loc">{w.location}</p>
            </div>
            <div class="exp__body">
              <h3 class="exp__role">{w.position}</h3>
              <p class="exp__company">{w.name}</p>
              {w.summary && <p class="exp__summary">{w.summary}</p>}
              <ul class="exp__highlights">
                {w.highlights.map((h) => <li>{h}</li>)}
              </ul>
              {w.keywords.length > 0 && (
                <div class="exp__stack">
                  <TagList items={w.keywords} label={`${w.name} stack`} />
                </div>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .experience {
    position: relative;
    isolation: isolate;
    overflow: clip;
  }
  .experience__content {
    position: relative;
    z-index: 1;
  }
  .exp__list {
    border-bottom: 1px solid var(--line);
  }
  .exp__item {
    display: grid;
    grid-template-columns: minmax(9rem, 15rem) 1fr;
    gap: var(--space-s) var(--space-m);
    padding: var(--space-m) 0;
    border-top: 1px solid var(--line);
  }
  .exp__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    position: sticky;
    top: var(--space-s);
    align-self: start;
    height: fit-content;
  }
  .exp__range {
    display: flex;
    align-items: center;
    gap: 0.5em;
    color: var(--ink);
  }
  .exp__now {
    color: var(--accent);
    font-size: 0.7em;
    animation: pulse 2.4s var(--ease) infinite;
  }
  .exp__loc {
    color: var(--faint);
    font-size: var(--step--1);
  }
  .exp__role {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-variation-settings: 'opsz' 30, 'wght' 520, var(--wonk-off);
    line-height: 1.1;
  }
  .exp__company {
    font-family: var(--font-mono);
    font-size: var(--step-0);
    color: var(--accent-ink);
    margin-top: 0.2em;
    margin-bottom: var(--space-xs);
  }
  .exp__summary {
    color: var(--muted);
    max-width: var(--measure);
    margin-bottom: var(--space-s);
  }
  .exp__highlights {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    max-width: var(--measure);
  }
  .exp__highlights li {
    position: relative;
    padding-left: 1.4em;
  }
  .exp__highlights li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-family: var(--font-mono);
  }
  .exp__stack {
    margin-top: var(--space-s);
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }
  @media (prefers-reduced-motion: reduce) {
    .exp__now { animation: none; }
  }
  @media (max-width: 640px) {
    .exp__item {
      grid-template-columns: 1fr;
      gap: var(--space-s);
    }
    .exp__meta {
      position: static;
      flex-direction: row;
      justify-content: space-between;
    }
  }
</style>
