---
import SectionHeader from '../molecules/SectionHeader.astro';
import SectionIllustration from '../molecules/SectionIllustration.astro';
import { getCV, t, resolveLocale } from '../../i18n';
const locale = resolveLocale(Astro.currentLocale);
const { languages } = getCV(locale);
const ui = t(locale);
---

<section class="langs shell" aria-labelledby="languages-title">
  <div class="section-heading-stage">
    <SectionHeader index="07" id="languages-title" title={ui.sections.languages.title} kicker={ui.sections.languages.kicker} axis="WGHT 460 · OPSZ 50" />
    <SectionIllustration
      src="/static/arc/languages-listening-station.webp"
      width={1774}
      height={887}
      duration={550}
      tileMin={8}
      tileMax={28}
      artWidth="clamp(320px, 36vw, 540px)"
      artRight="-2%"
      artOpacity="0.4"
      mobileWidth="105vw"
      mobileRight="-32%"
      mobileOpacity="0.1"
    />
  </div>

  <div class="langs__content">
    <dl class="langs__list">
      {languages.map((l, i) => (
        <div class="langs__item">
          <dt class="langs__name">
            <span class="langs__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            {l.name}
          </dt>
          <dd class="langs__body">
            <span class="langs__level">{l.level}</span>
            {l.note && <span class="langs__note">{l.note}</span>}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .langs {
    position: relative;
    isolation: isolate;
    overflow: clip;
  }
  .langs__content {
    position: relative;
    z-index: 1;
  }
  .langs__list {
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .langs__item {
    display: grid;
    grid-template-columns: minmax(9rem, 15rem) 1fr;
    gap: var(--space-s) var(--space-m);
    padding: var(--space-m) 0;
    border-top: 1px solid var(--line);
    align-items: baseline;
  }
  .langs__item:last-child {
    border-bottom: 1px solid var(--line);
  }
  .langs__name {
    display: flex;
    align-items: baseline;
    gap: var(--space-s);
    font-family: var(--font-display);
    /* Matches the Experience / Volunteer row-title scale (shared row grid) */
    font-size: var(--step-1);
    font-variation-settings: 'opsz' 30, 'wght' 520, var(--wonk-off);
    line-height: 1.1;
  }
  .langs__num {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--accent);
  }
  .langs__body {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }
  .langs__level {
    font-family: var(--font-mono);
    font-size: var(--step-0);
    color: var(--accent-ink);
    letter-spacing: 0.02em;
  }
  .langs__note {
    color: var(--muted);
    max-width: var(--measure);
    text-wrap: pretty;
  }
  @media (max-width: 640px) {
    .langs__item {
      grid-template-columns: 1fr;
      gap: var(--space-xs);
    }
  }
</style>
