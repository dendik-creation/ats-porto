---
// Replaces the native page scrollbar: a fixed pixel-tiled rail on the right
// viewport edge, filled top-to-bottom by scroll progress. Not transition:persist'd
// — like Nav, it's cheap to re-render fresh from each page's own markup, and
// persisting it would pin a stale scoped-style hash on the live node across
// a CSS edit (see Nav's own comment on the same tradeoff). It's still mounted
// exactly once per page (Layout.astro renders it once), and its script
// re-queries + recomputes progress on every astro:page-load regardless, so
// there's no continuity to lose. Click/drag on the track seeks the page,
// mirroring native scrollbar-track behavior, but it doesn't replace
// keyboard scrollbar interaction, so it stays aria-hidden rather than
// claiming role="scrollbar".
---

<div
  class="pixel-scrollbar"
  data-pixel-scrollbar
  aria-hidden="true"
>
  <span class="pixel-scrollbar__percent" data-pixel-scrollbar-percent>0</span>
  <div class="pixel-scrollbar__track" data-pixel-scrollbar-track></div>
  <div class="pixel-scrollbar__fill" data-pixel-scrollbar-fill></div>
</div>

<style>
  .pixel-scrollbar {
    --scroll-progress: 0;
    position: fixed;
    top: 0;
    right: 0;
    width: 24px;
    height: 100vh;
    height: 100dvh;
    padding-right: env(safe-area-inset-right, 0px);
    z-index: 20; /* below Nav's overlay (z-40) and every fullscreen surface above it */
    pointer-events: none;
  }

  /* Click-to-seek: only the track/fill column is interactive, so the rail
     stays a no-op everywhere else it's fixed over page content. */
  .pixel-scrollbar__track,
  .pixel-scrollbar__fill {
    pointer-events: auto;
    cursor: pointer;
  }
  .pixel-scrollbar[data-inactive] {
    opacity: 0;
  }

  .pixel-scrollbar__track,
  .pixel-scrollbar__fill {
    position: absolute;
    top: 0;
    right: 0;
    width: 15px;
    background-repeat: repeat-y;
    background-size: 100% 8px;
  }

  .pixel-scrollbar__track {
    height: 100%;
    background-image: repeating-linear-gradient(
      to bottom,
      var(--line-strong) 0 5px,
      transparent 5px 8px
    );
    opacity: 0.2;
  }

  .pixel-scrollbar__fill {
    height: calc(var(--scroll-progress) * 100%);
    background-image: repeating-linear-gradient(to bottom, var(--ink) 0 5px, transparent 5px 8px);
    opacity: 0.85;
    transition: height 60ms steps(2, end);
  }

  /* Pixelated boundary tip: one small accent block at the leading edge,
     a pseudo-element rather than an extra DOM node. */
  .pixel-scrollbar__fill::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 5px;
    background: var(--accent);
  }

  /* Percentage readout: tracks the fill's leading edge, desktop only. */
  .pixel-scrollbar__percent {
    display: none;
    position: absolute;
    top: calc(var(--scroll-progress) * (100% - 1.4em));
    right: 100%;
    margin-right: var(--space-2xs, 6px);
    font-family: var(--font-mono);
    font-size: var(--step--0-5, 0.75rem);
    line-height: 1.4em;
    color: var(--ink);
    white-space: nowrap;
  }

  @media (min-width: 641px) {
    .pixel-scrollbar__percent {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pixel-scrollbar__fill {
      transition: none;
    }
  }

  @media (max-width: 640px) {
    .pixel-scrollbar {
      width: 12px;
    }
    .pixel-scrollbar__track,
    .pixel-scrollbar__fill {
      width: 5px;
      background-size: 100% 6px;
    }
    .pixel-scrollbar__track {
      background-image: repeating-linear-gradient(
        to bottom,
        var(--line-strong) 0 4px,
        transparent 4px 6px
      );
    }
    .pixel-scrollbar__fill {
      background-image: repeating-linear-gradient(to bottom, var(--ink) 0 4px, transparent 4px 6px);
    }
    .pixel-scrollbar__fill::after {
      height: 4px;
    }
  }
</style>

<script>
  const STEPS = 100;

  let bar: HTMLElement | null = null;
  let fill: HTMLElement | null = null;
  let track: HTMLElement | null = null;
  let percent: HTMLElement | null = null;
  let framePending = false;
  let observer: ResizeObserver | null = null;
  let lastQuantized = -1;

  function update() {
    framePending = false;
    if (!bar || !fill) return;

    const root = document.scrollingElement ?? document.documentElement;
    const maxScroll = root.scrollHeight - window.innerHeight;

    if (maxScroll <= 0) {
      bar.setAttribute('data-inactive', '');
      return;
    }
    bar.removeAttribute('data-inactive');

    const raw = Math.min(1, Math.max(0, root.scrollTop / maxScroll));
    const atBottom = root.scrollTop + window.innerHeight >= root.scrollHeight - 1;
    const quantized = atBottom ? 1 : Math.round(raw * STEPS) / STEPS;

    // Skip the style write (and its layout recalc) on the many scroll
    // frames that land on the same one-of-100 step.
    if (quantized === lastQuantized) return;
    lastQuantized = quantized;
    bar.style.setProperty('--scroll-progress', String(quantized));
    if (percent) percent.textContent = String(Math.round(quantized * 100) + "%");
  }

  function onScroll() {
    if (framePending) return;
    framePending = true;
    requestAnimationFrame(update);
  }

  // Click/drag anywhere on the rail scrolls the page to that fraction —
  // same seek behavior as clicking a native scrollbar track.
  function seekTo(clientY: number) {
    if (!track) return;
    const rect = track.getBoundingClientRect();
    const fraction = Math.min(1, Math.max(0, (clientY - rect.top) / rect.height));
    const root = document.scrollingElement ?? document.documentElement;
    root.scrollTo({ top: fraction * (root.scrollHeight - window.innerHeight) });
  }

  function onPointerDown(e: PointerEvent, el: HTMLElement) {
    seekTo(e.clientY);
    el.setPointerCapture(e.pointerId);
    el.addEventListener('pointermove', onPointerMove);
    el.addEventListener(
      'pointerup',
      () => el.removeEventListener('pointermove', onPointerMove),
      { once: true },
    );
  }

  function onPointerMove(e: PointerEvent) {
    seekTo(e.clientY);
  }

  function init() {
    bar = document.querySelector<HTMLElement>('[data-pixel-scrollbar]');
    fill = bar?.querySelector<HTMLElement>('[data-pixel-scrollbar-fill]') ?? null;
    track = bar?.querySelector<HTMLElement>('[data-pixel-scrollbar-track]') ?? null;
    percent = bar?.querySelector<HTMLElement>('[data-pixel-scrollbar-percent]') ?? null;
    if (!bar || !fill) return;

    update();

    observer ??= new ResizeObserver(() => update());
    observer.observe(document.body);
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  document.addEventListener('pointerdown', (e) => {
    const target = (e.target as HTMLElement)?.closest<HTMLElement>(
      '[data-pixel-scrollbar-track], [data-pixel-scrollbar-fill]',
    );
    if (target) onPointerDown(e as PointerEvent, target);
  });
  // Fires on first load and after every ClientRouter swap (see scroll-to-section.ts).
  document.addEventListener('astro:page-load', init);
</script>
