---
// Manual (no autoplay) image carousel for the /projects showcase rows.
// Transition is a localized tier of the site's Pixel Motion System (see
// src/scripts/pixel-transition.ts) — an OPPOSITE-theme ghost layer leads,
// the destination image (stacked on top of the current one) lags behind it,
// both materializing in through the same chunky, clipped pixel cascade,
// propagating right-to-left on Next and left-to-right on Previous, clipped
// entirely to the carousel's own bounds. Same lead/lag ghost technique as
// Nav's menu panel and the Lightbox.
import { t, resolveLocale } from '../../i18n';

interface Props {
  images: string[];
  reverse?: boolean; // true = fade the right edge instead of the left (matches ProjectShowcase's mirrored layout)
}
const { images, reverse = false } = Astro.props;
const ui = t(resolveLocale(Astro.currentLocale));
---

{images.length > 0 && (
  <div class:list={['carousel', { 'carousel--reverse': reverse }]} data-carousel data-images={JSON.stringify(images)}>
    <img class="carousel__img" data-carousel-image alt="" />
    <div class="carousel__ghost" data-carousel-ghost aria-hidden="true"></div>
    <img class="carousel__img carousel__img--next" data-carousel-image-next alt="" aria-hidden="true" />
    {/* Painted above the images but below the arrow buttons (DOM order),
       so the buttons stay clickable even where the fade is fully opaque. */}
    <div class="carousel__fade" aria-hidden="true"></div>

    {images.length > 1 && (
      <>
        <button type="button" class="carousel__arrow carousel__arrow--prev" data-carousel-prev aria-label={ui.projects.lightbox.prevAria}>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
            <path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button type="button" class="carousel__arrow carousel__arrow--next" data-carousel-next aria-label={ui.projects.lightbox.nextAria}>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
            <path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </>
    )}
  </div>
)}

<style>
  .carousel {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .carousel__img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  /* Ghost layer — sits between the current and destination images, painted
     in the OPPOSITE theme's tone for the duration of the pixel transition
     only (identical technique to Nav's .sm-ghost / Lightbox's .lb-ghost: it
     leads, the destination image lags a beat behind it, so a band of
     opposite-theme color is visible at the advancing pixel edge before the
     real destination photo catches up). Never touches :root[data-theme] —
     colors below are restated from tokens.css, kept in sync with those, not
     a new palette. */
  .carousel__ghost {
    position: absolute;
    inset: 0;
    background: #1a1814;
    clip-path: inset(0 0 0 100%);
    visibility: hidden;
    pointer-events: none;
  }
  :root[data-theme='dark'] .carousel__ghost {
    background: #f0ece1;
  }
  /* Destination image, stacked on top of the ghost — clip-path starts fully
     collapsed (pre-JS baseline) and materializes in through the shared
     Pixel Motion System's chunky clip-path cascade (see the component
     script), never a smooth wipe. Always non-interactive: the base image
     and controls below/above it stay the real hit targets. */
  .carousel__img--next {
    clip-path: inset(0 0 0 100%);
    pointer-events: none;
  }

  /* Fades the edge that bleeds toward the info text into the paper behind
     it — ProjectCard's exact gradient, just living below the arrow buttons
     in paint order (DOM order) so they stay clickable through it. */
  .carousel__fade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to right, var(--paper) 0%, transparent 35%);
  }
  .carousel--reverse .carousel__fade {
    background: linear-gradient(to left, var(--paper) 0%, transparent 35%);
  }
  @media (max-width: 768px) {
    .carousel__fade {
      background: none;
    }
  }

  .carousel__arrow {
    position: absolute;
    z-index: 5;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: color-mix(in oklab, var(--paper) 82%, transparent);
    backdrop-filter: blur(4px);
    color: var(--ink);
    cursor: pointer;
    opacity: 0;
    transition: opacity var(--dur-1) var(--ease), border-color var(--dur-1) var(--ease), color var(--dur-1) var(--ease);
  }
  .carousel:hover .carousel__arrow,
  .carousel:focus-within .carousel__arrow {
    opacity: 1;
  }
  .carousel__arrow--prev { left: var(--space-xs); }
  .carousel__arrow--next { right: var(--space-xs); }
  .carousel__arrow:hover,
  .carousel__arrow:focus-visible {
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel__arrow { transition: none; }
  }
</style>

<script>
  import { buildPixelPlan, buildClipKeyframes, resolveTileSize, prefersReducedMotion, PIXEL_EASE } from '../../scripts/pixel-transition';

  function mountCarousel(root: HTMLElement, signal: AbortSignal) {
    const images: string[] = JSON.parse(root.dataset.images ?? '[]');
    const total = images.length;
    if (total === 0) return;

    const img = root.querySelector<HTMLImageElement>('[data-carousel-image]');
    const ghost = root.querySelector<HTMLElement>('[data-carousel-ghost]');
    const nextImg = root.querySelector<HTMLImageElement>('[data-carousel-image-next]');
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
    if (!img || !ghost || !nextImg) return;

    let index = 0;
    img.src = images[0];
    if (total <= 1) return; // nothing to navigate to, no buttons rendered

    const prefersReduced = prefersReducedMotion();
    // How far ahead the opposite-theme ghost runs relative to the
    // destination image — same lead/lag split Nav's menu ghost uses.
    const GHOST_LEAD_MS = 110;
    let animating = false;
    let imgAnim: Animation | null = null;
    let ghostAnim: Animation | null = null;

    // Waits for the destination bitmap to actually be paintable before the
    // reveal starts, so no half-loaded frame is ever exposed. decode() is
    // the standard way to do that off the main thread; onload/onerror is
    // the fallback for browsers/images where it's unavailable.
    const loadInto = (el: HTMLImageElement, src: string) =>
      new Promise<boolean>((resolve) => {
        el.src = src;
        if (typeof el.decode === 'function') {
          el.decode().then(() => resolve(true), () => resolve(false));
        } else if (el.complete) {
          resolve(true);
        } else {
          el.onload = () => resolve(true);
          el.onerror = () => resolve(false);
        }
      });

    // Next propagates right → left, Previous left → right: origin sits just
    // outside the edge the wave starts from, direction biases the spread
    // toward the opposite edge — same technique as Nav's menu cascade, just
    // scoped to the carousel's own (measured once) rect instead of the
    // viewport.
    const swapTo = (targetIndex: number, direction: 1 | -1) => {
      if (animating) return;
      const nextIndex = ((targetIndex % total) + total) % total;
      if (nextIndex === index) return;

      if (prefersReduced) {
        index = nextIndex;
        img.src = images[index];
        return;
      }

      animating = true;
      loadInto(nextImg, images[nextIndex]).then((loaded) => {
        if (!loaded) {
          nextImg.removeAttribute('src');
          animating = false;
          return;
        }

        const rect = root.getBoundingClientRect();
        const smaller = Math.min(rect.width, rect.height);
        const desktopTile = Math.max(14, Math.min(24, Math.round(smaller * 0.055)));
        const tileSize = resolveTileSize(desktopTile, 18);
        const origin = direction === 1
          ? { x: rect.width + rect.height, y: rect.height / 2 }
          : { x: -rect.height, y: rect.height / 2 };
        const plan = buildPixelPlan({
          width: rect.width,
          height: rect.height,
          origin,
          tileSize,
          direction: { x: -direction, y: 0 },
        });
        const keyframes = buildClipKeyframes(plan, { buckets: 30 });
        const totalMs = 650;
        const segmentMs = totalMs - GHOST_LEAD_MS;

        imgAnim?.cancel();
        ghostAnim?.cancel();
        ghost.style.visibility = 'visible';
        ghostAnim = ghost.animate(keyframes, { duration: segmentMs, easing: PIXEL_EASE, fill: 'forwards' });
        imgAnim = nextImg.animate(keyframes, {
          duration: segmentMs,
          delay: GHOST_LEAD_MS,
          easing: PIXEL_EASE,
          fill: 'both',
        });

        Promise.all([ghostAnim.finished, imgAnim.finished])
          .then(() => {
            index = nextIndex;
            img.src = images[index];
            nextImg.style.clipPath = 'inset(0 0 0 100%)';
            ghost.style.clipPath = 'inset(0 0 0 100%)';
            ghost.style.visibility = 'hidden';
            ghostAnim?.cancel();
            imgAnim?.cancel();
            animating = false;
          })
          .catch(() => {
            animating = false;
          });
      });
    };

    prevBtn?.addEventListener('click', () => swapTo(index - 1, -1), { signal });
    nextBtn?.addEventListener('click', () => swapTo(index + 1, 1), { signal });
  }

  let cleanup: AbortController | null = null;
  function initCarousels() {
    cleanup?.abort();
    cleanup = new AbortController();
    const { signal } = cleanup;
    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => mountCarousel(root, signal));
  }

  document.addEventListener('astro:page-load', initCarousels);
</script>
