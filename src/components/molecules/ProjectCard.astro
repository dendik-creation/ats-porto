---
import { getRelativeLocaleUrl } from 'astro:i18n';
import TagList from '../atoms/TagList.astro';
import type { Project } from '../../data/cv';
import { projectLinks } from '../../data/format';
import { t, resolveLocale } from '../../i18n';
import Github from '../atoms/icons/Github.astro';
import GooglePlay from '../atoms/icons/GooglePlay.astro';
import Globe from '../atoms/icons/Globe.astro';

interface Props {
  project: Project;
  index: number; // 1-based, for the running number motif
}
const { project, index } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const ui = t(locale);
const num = String(index).padStart(2, '0');
const year = project.date.slice(0, 4);
const href = getRelativeLocaleUrl(locale, `/projects/${project.slug}`);
const links = projectLinks(project, locale);
const primaryImage = project.images?.[0];
const visibleKeywords = project.keywords.slice(0, 3);
const remainingKeywordCount = project.keywords.length - visibleKeywords.length;
const projectKeywords = remainingKeywordCount > 0
  ? [...visibleKeywords, `+${remainingKeywordCount}`]
  : visibleKeywords;

// 'mono' icons carry a fixed brand color baked into their SVG paths, so they
// need the grayscale+invert treatment to stay visible in dark mode. Globe
// draws with stroke="currentColor" and already tracks the theme via --ink,
// so filtering it on top of that inverts it right back to dark.
const quickLinksIcon = (label: string) => {
  const cleanQuickLink = label.trim().toLocaleLowerCase();
  switch (cleanQuickLink) {
    case 'live':
      return Globe;
    case 'code':
      return Github;
    case 'google play':
      return GooglePlay;
    default:
      return null;
  }
}

const quickLinksIconIsMono = (label: string) => label.trim().toLocaleLowerCase() !== 'live';
---

<article class:list={['proj', { 'proj--has-media': Boolean(primaryImage) }]}>
  {primaryImage && (
    <div class="proj__media" data-pixel-reveal aria-hidden="true">
      <img src={primaryImage} alt="" loading="lazy" decoding="async" />
    </div>
  )}
  <div class="proj__top">
    <span class="proj__num" aria-hidden="true">{num}</span>
    <span class="proj__year label">{year}</span>
  </div>
  <h3 class="proj__title">
    <a class="proj__link" href={href}>
      {project.name}
      <svg class="proj__arrow" viewBox="0 0 24 24" width="0.55em" height="0.55em" aria-hidden="true" focusable="false">
        <path d="M7 17L17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </h3>
  <p class="proj__role">{project.role}</p>
  <p class="proj__desc">{project.description}</p>
  <TagList items={projectKeywords} label={ui.projects.stackAria(project.name)} />
  {links.length > 0 && (
    <ul class="proj__links" aria-label={ui.projects.linksAria(project.name)}>
      {links.map((l) => {
        const Icon = quickLinksIcon(l.label);
        const mono = quickLinksIconIsMono(l.label);
        return (
          <li>
            <a class="proj__ext" href={l.href} target="_blank" rel="noopener noreferrer">
              {Icon && (
                <span class:list={['quick-icon', mono && 'quick-icon--mono']}>
                  <Icon width={14} height={14} role="img" aria-hidden="true" />
                </span>
              )}
              {l.label === 'Code' ? 'Repo' : l.label}
              <svg viewBox="0 0 24 24" width="0.7em" height="0.7em" aria-hidden="true" focusable="false">
                <path d="M7 17L17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </li>
        );
      })}
    </ul>
  )}
</article>

<style>
  .proj {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-m) 0;
    border-top: 1px solid var(--line);
    overflow: hidden;
  }
  .proj__media {
    position: absolute;
    z-index: -1;
    top: 0;
    right: 0;
    bottom: 0;
    width: 44%;
    pointer-events: none;
  }
  .proj__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, var(--paper) 0%, transparent 35%);
  }

  /*disable gradient proj__media for mobile*/
  @media (max-width: 768px) {
    .proj__media::after {
      background: none;
    }
  }

  .proj__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .proj--has-media > :not(.proj__media),
  .proj--has-media > :global(.tags) {
    max-inline-size: calc(56% - var(--space-xs));
  }
  .proj__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
  }
  .proj__num {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.1em;
  }
  .proj__title {
    font-size: var(--step-1-5);
    width: fit-content;
  }
  .proj__link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25em;
    font-variation-settings: 'opsz' 40, 'wght' 480, var(--wonk-off);
    transition: font-variation-settings var(--dur-2) var(--ease), color var(--dur-1) var(--ease);
  }
  .proj__arrow {
    color: var(--accent);
    transform: translateY(-0.05em);
    transition: transform var(--dur-1) var(--ease);
  }
  .proj:hover .proj__link,
  .proj__link:focus-visible {
    font-variation-settings: 'opsz' 72, 'wght' 620, var(--wonk-on);
    color: var(--accent-ink);
  }
  .proj:hover .proj__arrow,
  .proj__link:focus-visible .proj__arrow {
    transform: translate(0.15em, -0.2em);
  }
  .proj__role {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--accent-ink);
    letter-spacing: 0.01em;
  }
  .proj__desc {
    color: var(--muted);
    max-width: var(--measure-tight);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  .proj__links {
    list-style: none;
    padding: 0;
    margin-top: var(--space-2xs);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-xs);
  }
  .proj__ext {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--ink);
    padding: 0.2em 0.6em;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    white-space: nowrap;
    transition: border-color var(--dur-1) var(--ease), color var(--dur-1) var(--ease);
  }
  .proj__ext:hover,
  .proj__ext:focus-visible {
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .quick-icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    color: currentColor;
  }
  .quick-icon--mono {
    filter: grayscale(60%);
  }
  :root[data-theme='dark'] .quick-icon--mono {
    filter: grayscale(60%) invert(1);
  }
  @media (max-width: 720px) {
    .proj {
      overflow: visible;
    }
    .proj__media {
      position: relative;
      z-index: 0;
      top: auto;
      right: auto;
      bottom: auto;
      order: 1;
      width: 100%;
      aspect-ratio: 16 / 9;
      margin-top: var(--space-s);
    }
    .proj--has-media > :not(.proj__media),
    .proj--has-media > :global(.tags) {
      max-inline-size: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .proj__ext { transition: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .proj__link {
      transition: color var(--dur-1) var(--ease);
    }
    .proj:hover .proj__link {
      font-variation-settings: 'opsz' 40, 'wght' 480, var(--wonk-off);
    }
    .proj__arrow { transition: none; }
  }
</style>
